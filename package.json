{
  "name": "jameshoward-us",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "prepare": "node scripts/prepare-content.mjs",
    "dev": "npm run prepare && astro dev",
    "build": "npm run prepare && node scripts/prepare-build.mjs && astro build --silent && node scripts/finalize-build.mjs",
    "preview": "astro preview",
    "check": "npm run prepare && astro check",
    "audit": "node scripts/audit-native-content.mjs && node scripts/validate-writing-data.mjs && node scripts/validate-subject-data.mjs && node scripts/validate-source-assets.mjs",
    "audit:navigation": "node scripts/audit-navigation.mjs",
    "audit:acceptance": "node scripts/audit-site-acceptance.mjs",
    "audit:a11y": "node scripts/audit-accessibility.mjs",
    "audit:search": "node scripts/audit-search.mjs",
    "audit:external": "node scripts/audit-external-links.mjs",
    "audit:repository": "node scripts/audit-repository.mjs",
    "validate": "npm run audit && npm run check && npm run build && node scripts/validate-build.mjs && node scripts/audit-site-acceptance.mjs && node scripts/audit-accessibility.mjs && node scripts/audit-search.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "astro": "7.3.2",
    "fast-glob": "3.3.3",
    "fuse.js": "7.5.0",
    "gray-matter": "4.0.3",
    "katex": "0.18.7",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "axe-core": "4.10.3",
    "jsdom": "30.1.0",
    "parse5": "7.3.0",
    "typescript": "6.0.3",
    "undici": "8.10.2"
  }
}
