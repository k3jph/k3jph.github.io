---
import JHCard from './JHCard.astro';
import { sitePath } from '../lib/site';
const { item, heading='h3', variant='default', showCategory=false, showSummary=true, showImage=false, id }=Astro.props;const H=heading;const rawHref=item.detail_page||item.detail_url||item.ancestry?.page||item.url||item.publisher_url||item.evidence;const href=rawHref?sitePath(rawHref):undefined;
const metadata=[item.role||item.issuer,item.postnominal,item.date||item.dates].filter(Boolean).join(' · ');
const facts=[item.service_period&&`Service period: ${item.service_period}`,item.previous_grade&&`Previous grade: ${item.previous_grade}`,item.issuer_type&&`Classification: ${item.issuer_type}`].filter(Boolean);
---
<JHCard class="data-card" variant={variant} id={id}>
  {showImage&&item.image&&<figure class:list={['data-card__visual',{'data-card__visual--photo':item.image_kind==='photo'}]}><img src={item.image} alt={item.image_alt??''} loading="lazy" decoding="async"/></figure>}
  {showCategory&&item.category&&<p class="eyebrow">{item.category}</p>}
  <H>{href?<a href={href}>{item.title||item.name||item.organization}</a>:item.title||item.name||item.organization}</H>
  {metadata&&<p class="metadata">{metadata}</p>}
  {facts.length>0&&<ul class="data-card__facts">{facts.map((fact:string)=><li>{fact}</li>)}</ul>}
  {showSummary&&item.summary&&<p class="data-card__summary" set:html={item.summary}/>}
  {showImage&&item.image&&item.image_credit&&<p class="data-card__credit"><a href={item.image_source}>{item.image_credit}</a>{item.image_license_url&&<> · <a href={item.image_license_url}>{item.image_license}</a></>}{item.image_changes&&<> · {item.image_changes}</>}</p>}
</JHCard>
<style>
  .data-card__visual { float: right; display: grid; place-items: center; width: 6rem; aspect-ratio: 1; margin: 0 0 1rem 1.25rem; padding: .55rem; background: #fff; }
  .data-card__visual img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .data-card__visual--photo { width: min(40%, 10rem); aspect-ratio: 4/3; padding: 0; }
  .data-card__visual--photo img { object-fit: cover; }
  .data-card__summary, .data-card__credit { clear: both; }
  .data-card__facts { margin: .65rem 0 0; padding: 0; list-style: none; color: var(--color-slate-700); font: 600 .86rem/1.5 var(--font-sans); }
  .data-card__credit { margin-top: 1rem; color: var(--color-slate-700); font: .75rem/1.5 var(--font-sans); }
  .data-card__credit a { color: inherit; }
  .jh-card--dark .data-card__facts, .jh-card--dark .data-card__credit { color: rgb(255 255 255 / .76); }
  @media (max-width: 36rem) { .data-card__visual { width: 4.5rem; margin-left: 1rem; } .data-card__visual--photo { width: min(40%, 7rem); } }
</style>
