---
interface Props {
  entries: any[];
  kind: 'subject' | 'series';
  heading?: 'h2' | 'h3';
  variant?: 'default' | 'light';
}

const { entries, kind, heading = 'h3', variant = 'default' } = Astro.props as Props;
const Heading = heading;
---

<ul class:list={['writing-directory', { 'writing-directory--light': variant === 'light' }]}>
  {entries.map((entry) => (
    <li>
      <Heading><a href={entry.route}>{entry.title}</a></Heading>
      <p>{entry.description}</p>
      <p class="metadata">{kind === 'series' ? `${entry.part_count} parts` : `${entry.posts.length} selected essays`}</p>
    </li>
  ))}
</ul>

<style>
  .writing-directory { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) var(--space-6); margin: 0; padding: 0; list-style: none; }
  .writing-directory > li { position: relative; padding-left: var(--space-4); }
  .writing-directory > li::before { position: absolute; top: .25rem; bottom: .25rem; left: 0; width: 3px; background: var(--color-gold-500); content: ''; }
  .writing-directory :is(h2, h3) { margin: 0; font-size: 1.35rem; }
  .writing-directory :is(h2, h3) a { color: var(--color-navy-900); text-decoration-color: var(--color-gold-500); }
  .writing-directory p { margin: var(--space-2) 0 0; }
  .writing-directory .metadata { font-size: .82rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .writing-directory--light :is(h2, h3) a { color: #fff; }
  .writing-directory--light p { color: rgb(255 255 255 / 82%); }
  .writing-directory--light .metadata { color: var(--color-gold-300); }
  @media (max-width: 48rem) { .writing-directory { grid-template-columns: 1fr; gap: var(--space-4); } }
</style>
