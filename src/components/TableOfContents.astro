---
const { headings=[] } = Astro.props;
const shown = headings.filter((h:any)=>h.depth>=2&&h.depth<=3);
---
{shown.length>1 && <nav class="toc" aria-label="On this page"><p class="eyebrow">On this page</p><ol>{shown.map((h:any)=><li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>}
<style>.toc{margin:0 auto 2.5rem;padding:1.2rem 1.4rem;border-left:3px solid var(--color-gold-500);background:var(--color-slate-075);font-family:var(--font-sans)}.toc ol{margin:.5rem 0 0;padding-left:1.25rem}.toc .depth-3{margin-left:1rem;font-size:.9em}</style>
