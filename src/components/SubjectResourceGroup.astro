---
import { sitePath } from '../lib/site';

interface Props {
  items: any[];
  label: string;
  showFamily?: boolean;
}

const { items, label, showFamily = false } = Astro.props as Props;
---

<ul class="subject-resource-list" aria-label={label}>
  {items.map((item) => (
    <li>
      {(showFamily || item.metadata) && <p class="subject-resource-list__meta">{[showFamily && item.family, item.metadata].filter(Boolean).join(' · ')}</p>}
      <h3>{item.href ? <a href={sitePath(item.href)}>{item.title}</a> : item.title}</h3>
      {item.description && <p set:html={item.description}/>} 
    </li>
  ))}
</ul>

<style>
  .subject-resource-list { display: grid; gap: var(--space-5); margin: 0; padding: 0; list-style: none; }
  .subject-resource-list > li { position: relative; padding-left: var(--space-4); }
  .subject-resource-list > li::before { position: absolute; top: .25rem; bottom: .25rem; left: 0; width: 2px; background: var(--color-gold-500); content: ''; }
  .subject-resource-list h3 { margin: 0; font-size: clamp(1.15rem, 2vw, 1.45rem); }
  .subject-resource-list h3 a { color: var(--color-navy-900); text-decoration-color: var(--color-gold-500); }
  .subject-resource-list p { margin: var(--space-1) 0 0; color: var(--color-slate-700); }
  .subject-resource-list__meta { font: 700 .78rem/1.5 var(--font-sans); letter-spacing: .04em; text-transform: uppercase; }
</style>
