---
import siteData from '../../.generated/data/site.json';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div><img src="/assets/img/identity/jameshoward-wordmark.svg" alt="James Howard" class="footer-logo"><p>{siteData.settings.footer_settings.footer_tagline}</p></div>
    <div><h2>Elsewhere</h2><ul>{siteData.settings.other_sites.map((item:any)=><li><a href={item.url} target={item.target} rel={item.target ? 'me noopener' : undefined}>{item.title}</a></li>)}</ul></div>
    <div><h2>Site information</h2><ul>{siteData.settings.notices.map((item:any)=><li><a href={item.url} data-cookie-preferences={item.data?.['cookie-preferences'] != null ? '' : undefined}>{item.title}</a></li>)}</ul></div>
  </div>
  <div class="container footer-bottom"><p>© {new Date().getUTCFullYear()} James P. Howard, II</p><p class="social-links">{siteData.settings.social_media.map((item:any)=><a href={item.url} rel="me noopener">{item.name}</a>)}</p></div>
</footer>
<style>
  .site-footer{padding-block:3.5rem 1.5rem;color:#dce5ee;background:var(--color-navy-950);font-family:var(--font-sans)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:3rem}.footer-logo{width:min(15rem,100%);filter:brightness(0) invert(1)}h2{margin:0 0 1rem;color:#fff;font-size:1rem;text-transform:uppercase}ul{margin:0;padding:0;list-style:none}li{margin:.35rem 0}.site-footer a{color:#dce5ee}.footer-bottom{display:flex;justify-content:space-between;gap:2rem;margin-top:2.5rem;padding-top:1rem;border-top:1px solid rgb(255 255 255/.15);font-size:.82rem}.social-links{display:flex;flex-wrap:wrap;gap:.75rem}@media(max-width:44rem){.footer-grid{grid-template-columns:1fr}.footer-bottom{flex-direction:column}}
</style>
