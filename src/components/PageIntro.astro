---
interface Props { title: string; subtitle?: string; image?: string; compact?: boolean }
const { title, subtitle, image='/assets/img/header-home.webp', compact=false } = Astro.props;
---
<header class:list={['page-intro', {'page-intro--compact':compact}]} style={`--hero-image:url('${image}')`}>
  <div class="page-intro__shade"><div class="container page-intro__content"><p class="eyebrow">JamesHoward.us</p><h1>{title}</h1>{subtitle && <p>{subtitle}</p>}<div class="hero-mark"><img src="/assets/img/identity/kamon.svg" alt=""></div></div></div>
</header>
<style>
  .page-intro{background-color:var(--color-navy-800);background-image:var(--hero-image);background-position:center;background-size:cover}.page-intro__shade{display:grid;min-height:clamp(22rem,52vw,37rem);place-items:center;padding:4rem 0;background:linear-gradient(100deg,rgb(8 24 43/.92),rgb(8 24 43/.55))}.page-intro--compact .page-intro__shade{min-height:clamp(16rem,35vw,25rem)}.page-intro__content{color:#fff;text-align:center}.page-intro h1{max-width:65rem;margin:.25rem auto;color:#fff}.page-intro p:not(.eyebrow){max-width:50rem;margin:1rem auto;font-size:1.25rem}.hero-mark{display:flex;align-items:center;gap:1rem;width:min(18rem,60%);margin:1.5rem auto 0}.hero-mark:before,.hero-mark:after{content:'';flex:1;height:1px;background:#fff}.hero-mark img{width:2.2rem;filter:brightness(0) invert(1)}
</style>
