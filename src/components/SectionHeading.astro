---
import MartletSectionHeading from '@martlet/astro/SectionHeading.astro';
import HeadingDivider from './HeadingDivider.astro';

interface Props {
  title: string;
  id?: string;
  eyebrow?: string;
  description?: string;
  level?: 'h2' | 'h3';
  variant?: 'navy' | 'gold' | 'light';
  align?: 'center' | 'left';
}

const {
  title,
  id,
  eyebrow,
  description,
  level = 'h2',
  variant = 'navy',
  align = 'left',
} = Astro.props;
---
<MartletSectionHeading title={title} id={id} eyebrow={eyebrow} description={description} level={level} align={align}
  class={`section-heading section-heading--${variant} section-heading--${align}`}
  eyebrowClass="eyebrow" descriptionClass="section-heading__description">
  <HeadingDivider slot="divider" variant={variant}/>
  <slot/>
</MartletSectionHeading>
