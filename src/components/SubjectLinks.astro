---
interface Props {
  subjects: any[];
  current?: string;
  title?: string;
  description?: string;
}

const {
  subjects,
  current,
  title = 'Explore by subject',
  description = 'Follow the same ideas across Writing, Scholarship, Books, Software, Teaching, and other substantial work.',
} = Astro.props as Props;
const links = subjects.filter((subject) => subject.slug !== current);
---

<nav class="subject-links" aria-label={title}>
  <p class="eyebrow">Subjects</p>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
  <ul>
    {links.map((subject) => <li><a href={subject.route}>{subject.title}</a></li>)}
  </ul>
</nav>

<style>
  .subject-links { margin-top: var(--space-6); padding-top: var(--space-4); border-top: 1px solid var(--color-slate-300); text-align: left; }
  :global(.section > .container > .subject-links:first-child), :global(.section > .reading-container > .subject-links:first-child) { margin-top: 0; }
  .subject-links h2 { margin: 0; font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .subject-links > p:not(.eyebrow) { max-width: 42rem; margin: var(--space-2) 0 0; color: var(--color-slate-700); }
  .subject-links ul { display: flex; flex-wrap: wrap; gap: .65rem 1.5rem; margin: var(--space-3) 0 0; padding: 0; list-style: none; font: 700 .9rem/1.5 var(--font-sans); }
  .subject-links a { display: inline-block; padding-block: .25rem; color: var(--color-navy-900); text-decoration-color: var(--color-gold-500); }
  @media (max-width: 36rem) {
    .subject-links ul { display: grid; gap: var(--space-2); }
    .subject-links li + li::before { content: none; }
  }
</style>
