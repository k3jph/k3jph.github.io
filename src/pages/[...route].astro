---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro'; import PageIntro from '../components/PageIntro.astro'; import TableOfContents from '../components/TableOfContents.astro'; import HeadingDivider from '../components/HeadingDivider.astro'; import ArmoryNav from '../components/ArmoryNav.astro';
import siteData from '../../.generated/data/site.json'; import {formatDate,isPublished,normalizeAssetPath,routeParam,slugifyTag} from '../lib/site';
export async function getStaticPaths(){
  const blog=(await getCollection('blog')).filter(p=>isPublished(p.data));const ancestry=await getCollection('ancestry');const pages=await getCollection('pages');const entries=[...blog.map(e=>({entry:e,kind:'blog'})),...ancestry.map(e=>({entry:e,kind:'ancestry'})),...pages.map(e=>({entry:e,kind:'page'}))];
  const native=['/','/blog/','/ancestry/','/books/','/honors/','/service/','/software/','/teaching/','/search/','/404.html','/contact-me/','/contact-me.html','/feed.xml','/atom.xml','/sitemap.xml'];const occupied=new Set([...native,...entries.map(x=>x.entry.data.route)]);
  const paths:any[]=entries.map(x=>({params:{route:routeParam(x.entry.data.route)},props:x}));
  for(const item of siteData.redirects){if(!occupied.has(item.from)){occupied.add(item.from);paths.push({params:{route:routeParam(item.from)},props:{kind:'redirect',to:item.to}});}}
  return paths;
}
const {entry,kind}=Astro.props as any;
if(kind==='redirect') return Astro.redirect((Astro.props as any).to,301);
const {Content,headings}=await render(entry);const data:any=entry.data;const image=normalizeAssetPath(data.featured_image);const ancestryServices=(data.service_ids??[]).map((id:string)=>siteData.service.find((r:any)=>r.id===id)).filter((r:any)=>r?.ancestry);const hasManualToc=entry.body?.includes('class="page-toc"');const isArmory=Boolean(data.armory_section);const wideContent=kind==='ancestry'||hasManualToc||isArmory;
const description=data.description??data.excerpt??data.subtitle;const escapeHtml=(value:string)=>value.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');const creditsHtml=data.credits?escapeHtml(String(data.credits)).replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,'<a href="$2">$1</a>').replace(/^_(.*)_$/s,'<em>$1</em>'):undefined;
---
<BaseLayout title={data.title} description={description} image={image} canonical={data.route} type={kind==='blog'?'article':'website'} stylesheet={data.stylesheet} script={data.script} noindex={data.sitemap===false}>
  <PageIntro title={data.title} subtitle={kind==='blog'?formatDate(data.calendar_date):data.subtitle} image={image} compact={kind!=='blog'}/>
  {isArmory&&<ArmoryNav current={data.armory_section}/>}
  {kind==='blog'&&data.tags?.length>0&&<div class="post-tags"><div class="container"><ul class="pill-list">{data.tags.map((tag:string)=><li><a href={`/tag/${slugifyTag(tag)}/`}>{tag}</a></li>)}</ul></div></div>}
  <article class:list={['article-shell',{'article-shell--wide':wideContent}]}><div class={wideContent?'container':'reading-container'}>{!hasManualToc&&!isArmory&&<TableOfContents headings={headings}/>}<div class="content"><Content/></div>{ancestryServices.map((role:any,i:number)=><section class="ancestry-service" aria-labelledby={`ancestry-service-${i+1}`}><p class="eyebrow">Society service and leadership</p><h2 id={`ancestry-service-${i+1}`}>{role.ancestry.heading}</h2><p>{role.ancestry.summary}</p><a href="/service/">View the broader service record →</a></section>)}{creditsHtml&&<footer class="credits"><HeadingDivider compact/><p set:html={creditsHtml}/></footer>}</div></article>
  {kind==='blog'&&<nav class="reading-container post-nav" aria-label="Blog navigation"><a href="/blog/">← Back to the blog archive</a></nav>}
  {wideContent&&<script is:inline src="/assets/js/content-gallery.js"></script>}
</BaseLayout>
<style>.post-tags{padding:.8rem 0;color:#fff;background:var(--color-navy-700)}.post-tags .pill-list{justify-content:center;margin:0}.ancestry-service{margin-top:3rem;padding:1.5rem;border-top:3px solid var(--color-gold-500);background:var(--color-slate-075)}.ancestry-service h2{margin-top:0}.credits{margin-top:3rem;color:var(--color-slate-700);font-size:.9rem;text-align:center;overflow-wrap:anywhere}.post-nav{padding-bottom:4rem;font-family:var(--font-sans)}</style>
