---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';import DataCard from '../../components/DataCard.astro';import SectionHeading from '../../components/SectionHeading.astro';import siteData from '../../../.generated/data/site.json';import {slugifyTag} from '../../lib/site';const current=siteData.service.filter((x:any)=>x.current);const past=siteData.service.filter((x:any)=>!x.current);
---
<BaseLayout title="Service" image="/assets/img/service.webp"><PageIntro title="Service" subtitle="Public work, professional stewardship, and institutional responsibility." image="/assets/img/service.webp"/><section class="section section--navy"><div class="container"><SectionHeading title="Current Service" eyebrow="Active roles" variant="light"/><div class="record-grid">{current.map((x:any)=><DataCard item={x} id={x.id?`service-${slugifyTag(x.id)}`:undefined} variant="dark"/>)}</div></div></section><section class="section section--soft"><div class="container"><SectionHeading title="Past Service" eyebrow="Selected record"/><div class="record-grid">{past.map((x:any)=><DataCard item={x} id={x.id?`service-${slugifyTag(x.id)}`:undefined}/>)}</div></div></section></BaseLayout>
