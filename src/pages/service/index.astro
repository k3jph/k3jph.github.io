---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';import DataCard from '../../components/DataCard.astro';import siteData from '../../../.generated/data/site.json';const current=siteData.service.filter((x:any)=>x.current);const past=siteData.service.filter((x:any)=>!x.current);
---
<BaseLayout title="Service" image="/assets/img/service.webp" stylesheet="/assets/css/service.css"><PageIntro title="Service" subtitle="Public work, professional stewardship, and institutional responsibility." image="/assets/img/service.webp"/><section class="section"><div class="container"><p class="lead">Service is where an institutional idea has to survive contact with procedures, budgets, people, and consequences.</p><h2>Current Service</h2><div class="record-grid">{current.map((x:any)=><DataCard item={x}/>)}</div><h2>Past Service</h2><div class="record-grid">{past.map((x:any)=><DataCard item={x}/>)}</div></div></section></BaseLayout>
