---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import EditorialPostList from '../../../components/EditorialPostList.astro';
import WritingLinks from '../../../components/WritingLinks.astro';
import ResourceSubjects from '../../../components/ResourceSubjects.astro';
import writing from '../../../../.generated/data/writing.json';
import subjects from '../../../../.generated/data/subjects.json';

export function getStaticPaths() {
  return writing.subjects.map((subject) => ({ params: { subject: subject.slug }, props: { subject } }));
}

const { subject } = Astro.props;
const siteSubject = subjects.subjects.find((item) => item.writing_subject?.route === subject.route);
---

<BaseLayout title={`${subject.title} — Writing`} description={subject.description} image="/assets/img/blog.webp" canonical={subject.route}>
  <PageIntro title={subject.title} subtitle={subject.description} image="/assets/img/blog.webp" compact/>
  <WritingLinks current="subjects"/>
  <section class="section">
    <div class="reading-container">
      <SectionHeading title="Selected Essays"/>
      <EditorialPostList posts={subject.posts} label={`${subject.title} selected essays`}/>
      {siteSubject && <div class="writing-subject-connection"><ResourceSubjects subjects={[siteSubject]} title="Explore this subject across the site"/></div>}
    </div>
  </section>
</BaseLayout>

<style>
  .writing-subject-connection { margin-top: var(--space-6); }
</style>
