---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import WritingDirectory from '../../../components/WritingDirectory.astro';
import WritingLinks from '../../../components/WritingLinks.astro';
import writing from '../../../../.generated/data/writing.json';
---

<BaseLayout title="Writing Subjects" description="Curated paths through the substantial subjects in James Howard's writing." image="/assets/img/blog.webp" canonical="/writing/subjects/">
  <PageIntro title="Subjects" subtitle="Curated paths through substantial bodies of writing." image="/assets/img/blog.webp" compact/>
  <section class="section">
    <div class="container">
      <WritingDirectory entries={writing.subjects} kind="subject"/>
      <WritingLinks current="subjects"/>
    </div>
  </section>
</BaseLayout>
