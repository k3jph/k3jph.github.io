---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SubjectLinks from '../../components/SubjectLinks.astro';
import siteData from '../../../.generated/data/site.json';
import subjectsData from '../../../.generated/data/subjects.json';
import { slugifyTag } from '../../lib/site';

const current = siteData.teaching.institutions.filter((institution:any) => institution.current);
const historical = siteData.teaching.institutions.filter((institution:any) => !institution.current);
const relatedSubjects = subjectsData.subjects.filter((subject) => ['mathematics-statistics', 'operations-research-decision-systems', 'risk-resilience', 'public-policy-institutions', 'teaching-learning'].includes(subject.slug));
const courseId = (institution:string, course:string) => `teaching-${slugifyTag(institution)}-${slugifyTag(course)}`;
---
<BaseLayout title="Teaching" image="/assets/img/teaching.webp">
  <PageIntro title="Teaching" subtitle="Start with the problem; work backward to the machinery." image="/assets/img/teaching.webp"/>
  <section class="section section--navy"><div class="container"><SectionHeading title="Current Teaching" variant="light"/>{current.map((institution:any)=><section class="teaching-institution teaching-institution--dark"><h3>{institution.name}</h3><p class="metadata">{institution.years}</p>{institution.courses.map((course:any)=><details id={courseId(institution.id,course.code)}><summary><strong>{course.code} — {course.title}</strong> <span>({course.syllabi?.length??0} syllabus files)</span></summary><div><p>{course.description}</p>{course.syllabi?.length>0&&<ul>{course.syllabi.map((syllabus:any)=><li>{syllabus.file?<a href={syllabus.file}>{syllabus.label}</a>:syllabus.label}</li>)}</ul>}</div></details>)}</section>)}</div></section>
  <section class="section section--soft"><div class="container"><SectionHeading title="Historical Teaching"/>{historical.map((institution:any)=><section class="teaching-institution"><h3>{institution.name}</h3><p class="metadata">{institution.years}</p>{institution.courses.map((course:any)=><details id={courseId(institution.id,course.code)}><summary><strong>{course.code} — {course.title}</strong> <span>({course.syllabi?.length??0} syllabus files)</span></summary><div><p>{course.description}</p>{course.syllabi?.length>0&&<ul>{course.syllabi.map((syllabus:any)=><li>{syllabus.file?<a href={syllabus.file}>{syllabus.label}</a>:syllabus.label}</li>)}</ul>}</div></details>)}</section>)}</div></section>
  <section class="section section--cream"><div class="container"><SubjectLinks subjects={relatedSubjects} title="Explore the teaching record by subject"/></div></section>
</BaseLayout>
<style>.teaching-institution{max-width:58rem;margin:0 auto var(--space-6)}.teaching-institution>h3{margin-bottom:.2rem}.teaching-institution details{margin-top:var(--space-3);border:1px solid var(--color-slate-150);border-radius:var(--radius-sm);background:#fff;color:var(--color-ink)}.teaching-institution summary{padding:var(--space-3);cursor:pointer;font-family:var(--font-sans)}.teaching-institution details>div{padding:0 var(--space-4) var(--space-4)}.teaching-institution--dark>h3{color:#fff}.teaching-institution--dark>.metadata{color:rgb(255 255 255/.72)}</style>
