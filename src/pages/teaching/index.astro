---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';import siteData from '../../../.generated/data/site.json';
---
<BaseLayout title="Teaching" image="/assets/img/teaching.webp" stylesheet="/assets/css/teaching.css"><PageIntro title="Teaching" subtitle="Start with the problem; work backward to the machinery." image="/assets/img/teaching.webp"/><section class="section"><div class="container"><p class="lead">Getting the answer matters. Understanding why it works matters more.</p><h2>Teaching Record</h2>{siteData.teaching.institutions.map((institution:any)=><section><h3>{institution.name}</h3><p class="metadata">{institution.years}</p>{institution.courses.map((course:any)=><details><summary><strong>{course.code} — {course.title}</strong> ({course.syllabi?.length??0} syllabus files)</summary><p>{course.description}</p>{course.syllabi?.length>0&&<ul>{course.syllabi.map((s:any)=><li>{s.file?<a href={s.file}>{s.label}</a>:s.label}</li>)}</ul>}</details>)}</section>)}</div></section></BaseLayout>
