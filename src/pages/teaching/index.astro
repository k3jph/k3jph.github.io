---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SectionNav from '../../components/SectionNav.astro';
import TeachingInstitution from '../../components/TeachingInstitution.astro';
import SubjectLinks from '../../components/SubjectLinks.astro';
import siteData from '../../../.generated/data/site.json';
import subjectsData from '../../../.generated/data/subjects.json';

const current = siteData.teaching.institutions.filter((institution: any) => institution.current);
const historical = siteData.teaching.institutions.filter((institution: any) => !institution.current);
const relatedSubjects = subjectsData.subjects.filter((subject) => ['mathematics-statistics', 'operations-research-decision-systems', 'risk-resilience', 'public-policy-institutions', 'teaching-learning'].includes(subject.slug));
---
<BaseLayout title="Teaching" image="/assets/img/teaching.webp">
  <PageIntro title="Teaching" subtitle="Start with the problem; work backward to the machinery." image="/assets/img/teaching.webp"/>
  <SectionNav items={[{href:'#current-teaching',label:'Current teaching'},{href:'#historical-teaching',label:'Historical teaching'},{href:'#teaching-subjects',label:'Explore by subject'}]}/>
  <section class="section section--navy" aria-labelledby="current-teaching">
    <div class="container"><SectionHeading title="Current Teaching" id="current-teaching" variant="light"/>
      {current.map((institution: any) => <TeachingInstitution institution={institution} dark/>)}
    </div>
  </section>
  <section class="section" aria-labelledby="historical-teaching">
    <div class="container"><SectionHeading title="Historical Teaching" id="historical-teaching"/>
      {historical.map((institution: any) => <TeachingInstitution institution={institution}/>)}
    </div>
  </section>
  <section class="section section--cream" id="teaching-subjects"><div class="container"><SubjectLinks subjects={relatedSubjects} title="Explore the teaching record by subject"/></div></section>
</BaseLayout>
