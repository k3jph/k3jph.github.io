---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';import SectionHeading from '../../components/SectionHeading.astro';import siteData from '../../../.generated/data/site.json';
---
<BaseLayout title="Teaching" image="/assets/img/teaching.webp"><PageIntro title="Teaching" subtitle="Start with the problem; work backward to the machinery." image="/assets/img/teaching.webp"/><section class="section"><div class="reading-container"><p class="lead">Getting the answer matters. Understanding why it works matters more.</p></div></section><section class="section section--soft"><div class="container"><SectionHeading eyebrow="Courses and syllabi" title="Teaching Record"/>{siteData.teaching.institutions.map((institution:any)=><section class="teaching-institution"><h3>{institution.name}</h3><p class="metadata">{institution.years}</p>{institution.courses.map((course:any)=><details><summary><strong>{course.code} — {course.title}</strong> <span>({course.syllabi?.length??0} syllabus files)</span></summary><div><p>{course.description}</p>{course.syllabi?.length>0&&<ul>{course.syllabi.map((s:any)=><li>{s.file?<a href={s.file}>{s.label}</a>:s.label}</li>)}</ul>}</div></details>)}</section>)}</div></section></BaseLayout>
<style>.teaching-institution{max-width:58rem;margin:0 auto var(--space-6)}.teaching-institution>h3{margin-bottom:.2rem}.teaching-institution details{margin-top:var(--space-3);border:1px solid var(--color-slate-150);border-radius:var(--radius-sm);background:#fff}.teaching-institution summary{padding:var(--space-3);cursor:pointer;font-family:var(--font-sans)}.teaching-institution details>div{padding:0 var(--space-4) var(--space-4)}</style>
