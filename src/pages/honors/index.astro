---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';import DataCard from '../../components/DataCard.astro';import SectionHeading from '../../components/SectionHeading.astro';import siteData from '../../../.generated/data/site.json';const groups=[['professional','Professional Recognition'],['civic','Civic and Service Recognition'],['heraldic','Heraldic Recognition'],['ceremonial','Orders and Ceremonial Honors'],['peerage','Peerages and Titles'],['other','Other Distinctions']];
const usefulQualifiers=new Set(['Kentucky Colonel','President’s Volunteer Service Award — Bronze','Maryland Defense Force Meritorious Service Ribbon','Maryland Defense Force Commendation Ribbon','Grant of Arms','Knight Companion']);
---
<BaseLayout title="Honors" image="/assets/img/honors.webp"><PageIntro title="Honors" subtitle="Recognition organized by what it is and who conferred it." image="/assets/img/honors.webp"/>{groups.map(([kind,label],index)=><section class:list={['section',{'section--soft':index%2===0}]}><div class="container"><SectionHeading title={label}/><div class="record-grid">{siteData.honors.filter((x:any)=>x.category===kind).map((x:any)=><DataCard item={x} showSummary={usefulQualifiers.has(x.title)}/>)}</div></div></section>)}</BaseLayout>
