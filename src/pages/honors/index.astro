---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';import DataCard from '../../components/DataCard.astro';import siteData from '../../../.generated/data/site.json';const groups=[['professional','Professional Recognition'],['civic','Civic and Service Recognition'],['heraldic','Heraldic Recognition'],['ceremonial','Orders and Ceremonial Honors'],['peerage','Peerages and Titles'],['other','Other Distinctions']];
---
<BaseLayout title="Honors" image="/assets/img/honors.webp" stylesheet="/assets/css/honors.css"><PageIntro title="Honors" subtitle="Recognition organized by what it is and who conferred it." image="/assets/img/honors.webp"/><section class="section"><div class="container"><p class="lead">Professional and public recognition belongs first. The record then continues into heraldry, private and ceremonial orders, micronational honors, peerages, and other distinctions.</p>{groups.map(([kind,label])=><section><h2>{label}</h2><div class="record-grid">{siteData.honors.filter((x:any)=>x.category===kind).map((x:any)=><DataCard item={x}/>)}</div></section>)}</div></section></BaseLayout>
