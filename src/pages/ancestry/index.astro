---
import { getCollection } from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';import SectionHeading from '../../components/SectionHeading.astro';import JHCard from '../../components/JHCard.astro';import {sitePath} from '../../lib/site';
const records=(await getCollection('ancestry')).sort((a,b)=>a.data.title.localeCompare(b.data.title));const groups=[['lineage','Hereditary Societies'],['certificate','Heritage Certificates'],['family','Family Associations'],['military','Historic Military Companies']];const places=[...new Set(records.flatMap(r=>((r.data as any).places??[]) as string[]))].sort();const topics=[...new Set(records.flatMap(r=>((r.data as any).topics??[]) as string[]))].sort();
const searchable=(r:any)=>[r.data.title,r.data.subtitle,r.data.member_number,...(r.data.qualifying_ancestors??[]),...(r.data.places??[]),...(r.data.topics??[])].filter(Boolean).join(' ').toLowerCase();
---
<BaseLayout title="Ancestry" description="Documented genealogy and family-history research." image="/assets/img/ancestry.webp" script="/assets/js/ancestry.js"><PageIntro title="Ancestry" subtitle="A documentary index of lineages, people, places, and historical context." image="/assets/img/ancestry.webp"/><section class="section"><div class="reading-container ancestry-introduction"><p>Genealogy is mostly an exercise in refusing to believe family stories until the paperwork shows up. This section collects historical genealogy as a series of case studies in documented descent.</p><p>Ambiguity stays visible. A tidy story is not a substitute for a defensible one.</p></div></section><section class="section section--soft" id="find-a-record"><div class="container"><SectionHeading eyebrow="Search the collection" title="Find a Record"/><form id="ancestry-finder" class="control-grid" role="search"><div><label for="ancestry-query">Search</label><input id="ancestry-query" type="search" name="q" placeholder="Try Hoar, Ohio, Quakers, or 1185"></div><div><label for="ancestry-type">Type</label><select id="ancestry-type"><option value="">All record types</option>{groups.map(([v,l])=><option value={v}>{l}</option>)}</select></div><div><label for="ancestry-place">Place</label><select id="ancestry-place"><option value="">All places</option>{places.map(x=><option>{x}</option>)}</select></div><div><label for="ancestry-topic">Context</label><select id="ancestry-topic"><option value="">All contexts</option>{topics.map(x=><option>{x}</option>)}</select></div><button id="ancestry-reset" class="button" type="reset">Reset filters</button></form></div></section><section class="section" id="research-index"><div class="archive-container"><SectionHeading eyebrow={`${records.length} documented records`} title="Research Index"><p id="ancestry-result-count" role="status">Showing all {records.length} records.</p></SectionHeading><div id="ancestry-results">{groups.map(([kind,label])=><section class="ancestry-record-group" data-ancestry-group={kind}><SectionHeading title={label} level="h2"/><div class="record-grid">{records.filter(r=>r.data.class===kind).map(r=>{const d:any=r.data;return <JHCard class="ancestry-record" data-ancestry-record data-record-type={kind} data-record-places={(d.places??[]).join('|')} data-record-topics={(d.topics??[]).join('|')} data-record-search={searchable(r)}><p class="eyebrow">{label}</p><h3><a href={sitePath(d.route)}>{d.title}</a></h3>{d.subtitle&&<p>{d.subtitle}</p>}{d.qualifying_ancestors?.length>0&&<><p class="ancestry-card__label">Jure</p><p>{d.qualifying_ancestors.join(', ')}</p></>}{d.member_number&&<p class="metadata">Member no. {d.member_number}</p>}<a href={sitePath(d.route)}>View record →</a></JHCard>})}</div></section>)}</div><div id="ancestry-empty" hidden><h2>No ancestry records match those filters.</h2><button id="ancestry-empty-reset" class="button">Reset filters</button></div></div></section></BaseLayout>
<style>.ancestry-record-group+.ancestry-record-group{margin-top:var(--space-7)}.ancestry-card__label{margin-bottom:0;color:var(--color-gold-700);font:700 .76rem var(--font-sans);letter-spacing:.08em;text-transform:uppercase}.ancestry-card__label+p{margin-top:.25rem}</style>
