---
import { getCollection } from 'astro:content';import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';
const records=(await getCollection('ancestry')).sort((a,b)=>a.data.title.localeCompare(b.data.title));const groups=[['lineage','Hereditary Societies'],['certificate','Heritage Certificates'],['family','Family Associations'],['military','Historic Military Companies']];const places=[...new Set(records.flatMap(r=>((r.data as any).places??[]) as string[]))].sort();const topics=[...new Set(records.flatMap(r=>((r.data as any).topics??[]) as string[]))].sort();
const searchable=(r:any)=>[r.data.title,r.data.subtitle,r.data.member_number,...(r.data.qualifying_ancestors??[]),...(r.data.places??[]),...(r.data.topics??[])].filter(Boolean).join(' ').toLowerCase();
---
<BaseLayout title="Ancestry" description="Documented genealogy and family-history research." image="/assets/img/ancestry.webp" stylesheet="/assets/css/ancestry.css" script="/assets/js/ancestry.js"><PageIntro title="Ancestry" subtitle="A documentary index of lineages, people, places, and historical context." image="/assets/img/ancestry.webp"/><section class="section"><div class="container ancestry-introduction"><p>Genealogy is mostly an exercise in refusing to believe family stories until the paperwork shows up. This section collects historical genealogy as a series of case studies in documented descent.</p><p>Ambiguity stays visible. A tidy story is not a substitute for a defensible one.</p></div></section><section class="section section--soft" id="find-a-record"><div class="container"><div class="section-heading"><p class="eyebrow">Search the collection</p><h2>Find a Record</h2></div><form id="ancestry-finder" role="search"><label>Search <input id="ancestry-query" type="search" name="q" placeholder="Try Hoar, Ohio, Quakers, or 1185"></label><label>Type <select id="ancestry-type"><option value="">All record types</option>{groups.map(([v,l])=><option value={v}>{l}</option>)}</select></label><label>Place <select id="ancestry-place"><option value="">All places</option>{places.map(x=><option>{x}</option>)}</select></label><label>Context <select id="ancestry-topic"><option value="">All contexts</option>{topics.map(x=><option>{x}</option>)}</select></label><button id="ancestry-reset" type="reset">Reset filters</button></form></div></section><section class="section" id="research-index"><div class="container"><div class="section-heading"><p class="eyebrow">{records.length} documented records</p><h2>Research Index</h2><p id="ancestry-result-count" role="status">Showing all {records.length} records.</p></div><div id="ancestry-results">{groups.map(([kind,label])=><section class="ancestry-record-group" data-ancestry-group={kind}><h2>{label}</h2><div class="record-grid">{records.filter(r=>r.data.class===kind).map(r=>{const d:any=r.data;return <article class="record-card ancestry-record" data-ancestry-record data-record-type={kind} data-record-places={(d.places??[]).join('|')} data-record-topics={(d.topics??[]).join('|')} data-record-search={searchable(r)}><h3><a href={d.route}>{d.title}</a></h3>{d.subtitle&&<p>{d.subtitle}</p>}<p>{(d.qualifying_ancestors??[]).join(', ')}</p><a href={d.route}>View record →</a></article>})}</div></section>)}</div><div id="ancestry-empty" hidden><h2>No ancestry records match those filters.</h2><button id="ancestry-empty-reset">Reset filters</button></div></div></section></BaseLayout>
