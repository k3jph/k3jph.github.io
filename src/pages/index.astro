---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeadingDivider from '../components/HeadingDivider.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { formatDate, isPublished, normalizeAssetPath, sitePath } from '../lib/site';
import siteData from '../../.generated/data/site.json';
import subjects from '../../.generated/data/subjects.json';

const posts = (await getCollection('blog'))
  .filter((post) => isPublished(post.data))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 4);

const featuredProjects = (siteData.settings.sites ?? [])
  .filter((site: any) => site.showcase)
  .sort((a: any, b: any) => (a.order ?? 999) - (b.order ?? 999));

const heroProjects = featuredProjects.slice(0, 4);

const subjectArtwork: Record<string, string> = {
  'artificial-intelligence': '/assets/img/2026/neurons-all-the-way-down.webp',
  'mathematics-statistics': '/assets/img/2025/the-gini-mean-difference.webp',
  'operations-research-decision-systems': '/assets/img/2026/the-model-is-not-the-system.webp',
  'risk-resilience': '/assets/img/2026/effective-challenge-is-now-optional.webp',
  'public-policy-institutions': '/assets/img/2026/the-39-trillion-number-is-wrong.webp',
  'software-open-systems': '/assets/img/news/case-risc-v.webp',
  'heraldry-visual-identity': '/assets/img/2024/on-the-royal-badges.webp',
  'teaching-learning': '/assets/img/2025/the-ancient-dignity-of-education.webp',
};

const subjectCards = subjects.subjects.map((subject: any) => ({
  ...subject,
  image: subjectArtwork[subject.slug],
}));

// These destinations have no equivalent in the main menu.
const additionalDestinations = [
  {
    title: 'Books',
    href: '/books/',
    description: 'Long-form work in mathematics, policy, operations research, and teaching.',
  },
  {
    title: 'Software',
    href: '/software/',
    description: 'Open-source projects and working tools built around difficult problems.',
  },
  {
    title: 'Consulting',
    href: '/consulting/',
    description: 'Have a complicated problem of your own?',
  },
];

const personalDestinations = [
  {
    title: 'Ancestry',
    href: '/ancestry/',
    description: 'Documented lineages, people, places, and the evidence connecting them.',
    image: '/assets/img/ancestry/ofgd/granville-grant-teague-1756-11-05.webp',
    imagePosition: 'center 35%',
  },
  {
    title: 'Honors',
    href: '/honors/',
    description: 'Awards, appointments, decorations, and other recognition.',
    image: '/assets/img/kingdom-of-hawaii-medal-hero.webp',
    imagePosition: 'center 38%',
  },
  {
    title: 'Coat of Arms',
    href: '/coat-of-arms/',
    description: 'The grant, insignia, emblazonments, tartan, and documentary record.',
    image: '/assets/img/armory/jhoward-coa-achernushkin-960px.webp',
    imagePosition: 'center',
    imageFit: 'contain',
  },
  {
    title: 'Media Archive',
    href: '/media/',
    description: 'Interviews, quotations, profiles, and appearances collected over the years.',
    image: '/assets/img/news/radio-studio.webp',
    imagePosition: 'center',
  },
];
---

<BaseLayout title="Home" profilePage>
  <section class="home-hero">
    <div class="container home-hero__top">
      <div class="home-hero__identity">
        <h1 class="visually-hidden">James Howard</h1>
        <img class="home-hero__arms" src="/assets/img/identity/jameshoward-arms.svg" alt="James Howard coat of arms">
        <p>A Mathematician, a Different Kind of Mathematician, and a Statistician</p>
      </div>

      <section class="home-hero__projects" aria-labelledby="home-projects">
        <div class="home-hero__label">
          <h2 id="home-projects">Selected Projects</h2>
        </div>
        <div class="home-project-grid">
          {heroProjects.map((project: any) => (
            <a
              class="home-project-card"
              href={project.url}
              target={project.target}
              rel={project.target ? 'noopener noreferrer' : undefined}
              aria-label={`Visit ${project.title}`}
            >
              <img
                src={project.image}
                alt=""
                loading="eager"
                decoding="async"
                style={`object-position: ${project.image_position ?? 'center'};`}
              />
              <span class="home-card-shade"></span>
              <span class="home-project-card__copy">
                {project.kind && <small>{project.kind}</small>}
                <strong>{project.title}</strong>
              </span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <div class="home-hero__divider">
      <HeadingDivider variant="light"/>
    </div>

    <section class="container home-hero__blog" data-home-section="blog" aria-labelledby="home-latest-writing">
      <div class="home-hero__blog-heading">
        <div>
          <h2 id="home-latest-writing">From the Blog</h2>
        </div>
        <a href="/blog/">Complete archive →</a>
      </div>
      <div class="home-blog-grid">
        {posts.map((post) => (
          <article class="home-blog-card">
            <a data-home-post href={sitePath(post.data.route)} aria-label={`Read ${post.data.title}`}>
              <img src={normalizeAssetPath(post.data.featured_image)} alt="" loading="eager" decoding="async">
              <span class="home-card-shade"></span>
              <span class="home-blog-card__copy">
                <small>{formatDate(post.data.calendar_date, 'short')}</small>
                <strong>{post.data.title}</strong>
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>
  </section>

  <section class="section section--cream home-discovery" data-home-section="subjects" aria-labelledby="home-subjects">
    <div class="container home-discovery__container">
      <SectionHeading title="Explore by Subject" id="home-subjects"/>
      <ul class="home-subject-grid">
        {subjectCards.map((subject: any) => (
          <li>
            <a class="home-subject-card" href={subject.route}>
              <span class="home-subject-card__image">
                <img src={subject.image} alt="" loading="lazy" decoding="async"/>
              </span>
              <div class="home-subject-card__copy">
                <h3>{subject.title}</h3>
                <span class="home-discovery-arrow" aria-hidden="true">↗</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <nav class="home-callouts" aria-label="Books, software, and consulting">
        {additionalDestinations.map((destination) => (
          <a class="home-callout" href={destination.href}>
            <span class="home-callout__title">{destination.title}<span aria-hidden="true"> →</span></span>
            <span class="home-callout__description">{destination.description}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section section--navy home-discovery home-archives" data-home-section="elsewhere" aria-labelledby="home-archives">
    <div class="container home-discovery__container">
      <SectionHeading title="Elsewhere on the Site" id="home-archives" variant="light"/>
      <ul class="home-archive-grid">
        {personalDestinations.map((destination) => (
          <li>
            <a class="home-archive-card" href={destination.href}>
              <span class:list={['home-archive-card__image', { 'home-archive-card__image--contain': destination.imageFit === 'contain' }]}>
                <img src={destination.image} alt="" loading="lazy" decoding="async" style={`object-position: ${destination.imagePosition};`}/>
              </span>
              <div class="home-archive-card__copy">
                <h3>{destination.title}<span aria-hidden="true"> →</span></h3>
                <span>{destination.description}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    align-content: center;
    gap: clamp(1.4rem, 2.4vh, 2.2rem);
    min-height: 100svh;
    padding: clamp(6.25rem, 9vh, 7.5rem) 0 clamp(1.5rem, 3vh, 2.5rem);
    overflow: hidden;
    background: #303030 url('/assets/img/header-home.webp') center/cover;
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);
    content: '';
  }

  .home-hero__top,
  .home-hero__blog,
  .home-hero__divider {
    position: relative;
    z-index: 1;
  }

  .home-hero__top,
  .home-hero__blog {
    width: min(94vw, 96rem);
  }

  .home-hero__divider {
    width: 100%;
  }

  .home-hero__top {
    display: grid;
    grid-template-columns: minmax(15rem, 28rem) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 5rem);
  }

  .home-hero__identity {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .home-hero__arms {
    width: min(100%, 28rem);
    max-height: 48vh;
    object-fit: contain;
    filter: drop-shadow(0 12px 25px rgb(0 0 0 / 20%));
  }

  .home-hero__identity p {
    max-width: 23rem;
    margin: 0;
    color: rgb(255 255 255 / 84%);
    font-size: clamp(.88rem, 1.15vw, 1.02rem);
    line-height: 1.45;
    text-align: center;
    text-wrap: balance;
  }

  .home-hero__projects {
    min-width: 0;
  }

  .home-hero__label,
  .home-hero__blog-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .7rem;
  }

  .home-hero__label h2,
  .home-hero__blog-heading h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.15rem, 1.7vw, 1.55rem);
    line-height: 1.12;
  }

  .home-project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(.65rem, 1vw, 1rem);
  }

  .home-project-card,
  .home-blog-card a {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--radius-md);
    background: #111;
    box-shadow: 0 12px 28px rgb(0 0 0 / 18%);
    text-decoration: none;
    isolation: isolate;
  }

  .home-project-card {
    aspect-ratio: 16 / 7;
  }

  .home-project-card img,
  .home-blog-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.88) contrast(1.03);
    transition: transform .35s ease, filter .35s ease;
  }

  .home-card-shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(to top, rgb(7 17 31 / 88%) 0%, rgb(7 17 31 / 24%) 58%, rgb(7 17 31 / 4%) 100%);
  }

  .home-project-card__copy,
  .home-blog-card__copy {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: .22rem;
    padding: .82rem .95rem;
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 75%);
  }

  .home-project-card__copy small,
  .home-blog-card__copy small {
    color: var(--color-gold-300);
    font: 700 .62rem/1.2 var(--font-sans);
    letter-spacing: .065em;
    text-transform: uppercase;
  }

  .home-project-card__copy strong,
  .home-blog-card__copy strong {
    color: #fff;
    font: 600 clamp(.86rem, 1.05vw, 1.04rem)/1.2 var(--font-serif);
    text-wrap: balance;
  }

  .home-project-card:hover img,
  .home-project-card:focus-visible img,
  .home-blog-card a:hover img,
  .home-blog-card a:focus-visible img {
    filter: saturate(1) contrast(1.05);
    transform: scale(1.035);
  }

  .home-project-card:hover,
  .home-project-card:focus-visible,
  .home-blog-card a:hover,
  .home-blog-card a:focus-visible {
    border-color: var(--color-gold-300);
  }

  .home-hero__blog {
    padding-top: 0;
  }

  .home-hero__blog-heading a {
    color: rgb(255 255 255 / 82%);
    font: 700 .74rem var(--font-sans);
  }

  .home-hero__blog-heading a:hover,
  .home-hero__blog-heading a:focus-visible {
    color: var(--color-gold-300);
  }

  .home-blog-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(.65rem, 1vw, 1rem);
  }

  .home-blog-card {
    min-width: 0;
  }

  .home-blog-card a {
    aspect-ratio: 16 / 6.5;
  }

  .home-blog-card__copy {
    padding: .72rem .85rem;
  }


  .home-discovery__container { --container-width: 88rem; }

  .home-subject-grid,
  .home-archive-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-subject-grid > li,
  .home-archive-grid > li { min-width: 0; }

  .home-subject-card,
  .home-archive-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(11 28 51 / 12%);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .home-subject-card__image,
  .home-archive-card__image {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-navy-950);
  }

  .home-subject-card__image img,
  .home-archive-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .35s ease;
  }

  .home-subject-card__copy {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    gap: .8rem;
    padding: 1.25rem;
    border-top: 3px solid var(--color-gold-500);
  }

  .home-subject-card h3,
  .home-archive-card h3 {
    margin: 0;
    color: var(--color-navy-900);
    font-size: clamp(1.05rem, 1.4vw, 1.4rem);
    line-height: 1.3;
  }

  .home-discovery-arrow {
    flex-shrink: 0;
    color: var(--color-gold-700);
    font: 400 1.8rem/1 var(--font-sans);
  }

  .home-subject-card:hover,
  .home-subject-card:focus-visible,
  .home-archive-card:hover,
  .home-archive-card:focus-visible {
    border-color: var(--color-gold-500);
    box-shadow: var(--shadow-md);
  }

  .home-subject-card:hover img,
  .home-subject-card:focus-visible img,
  .home-archive-card:hover img,
  .home-archive-card:focus-visible img { transform: scale(1.04); }

  .home-archive-card .home-archive-card__image--contain img {
    object-fit: contain;
    transform: none;
  }

  .home-callouts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: var(--space-5);
  }

  .home-callout {
    display: grid;
    align-content: start;
    gap: .6rem;
    padding: clamp(1.25rem, 2vw, 2rem);
    border-left: 4px solid var(--color-gold-300);
    color: #fff;
    background: var(--color-navy-900);
    text-decoration: none;
    transition: background-color .2s ease;
  }

  .home-callout:hover,
  .home-callout:focus-visible { color: #fff; background: var(--color-navy-700); }
  .home-callout__title { display: flex; justify-content: space-between; gap: 1rem; font: 600 clamp(1.25rem, 2vw, 1.8rem)/1.2 var(--font-display); }
  .home-callout__title > span { color: var(--color-gold-300); }
  .home-callout__description { color: rgb(255 255 255 / 84%); font-size: .98rem; line-height: 1.5; }

  .home-archives { background: var(--color-navy-900); }
  .home-archive-card__image { aspect-ratio: 4 / 3; }
  .home-archive-card__copy { display: grid; flex: 1; align-content: start; gap: .7rem; padding: 1.35rem; border-top: 3px solid var(--color-gold-500); }
  .home-archive-card__copy > span { color: var(--color-slate-700); font-size: .98rem; line-height: 1.55; }
  .home-archive-card h3 > span { color: var(--color-gold-700); }

  @media (max-width: 68rem) {
    .home-subject-grid,
    .home-archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 40rem), (max-aspect-ratio: 4/5) {
    .home-discovery__container { width: min(92vw, 44rem); }
    .home-subject-grid,
    .home-archive-grid,
    .home-callouts { grid-template-columns: 1fr; }
    .home-subject-card h3,
    .home-archive-card h3 { font-size: clamp(1.2rem, 3vw, 1.6rem); }
    .home-archive-card__image { aspect-ratio: 16 / 10; }
  }

  @media (max-width: 68rem) {
    .home-hero {
      align-content: start;
      min-height: 100svh;
    }

    .home-hero__top {
      grid-template-columns: minmax(12rem, 20rem) minmax(0, 1fr);
      gap: 2rem;
    }

    .home-hero__arms {
      max-height: 38vh;
    }

    .home-project-card {
      aspect-ratio: 16 / 8.5;
    }

    .home-blog-card a {
      aspect-ratio: 16 / 8;
    }
  }

  /* Tall viewports need the stacked composition even at laptop widths. */
  @media (max-width: 54rem), (max-aspect-ratio: 4/5) {
    .home-hero {
      align-content: start;
      min-height: auto;
      padding: 6.25rem 0 2.5rem;
      overflow: visible;
    }

    .home-hero__top {
      grid-template-columns: 1fr;
      width: min(92vw, 44rem);
    }

    .home-hero__identity {
      grid-template-columns: auto 1fr;
      align-items: center;
      justify-items: start;
      gap: 1.25rem;
    }

    .home-hero__arms {
      width: min(34vw, 12rem);
      max-height: none;
    }

    .home-hero__identity p {
      max-width: 23rem;
      text-align: left;
    }

    .home-hero__blog {
      width: min(92vw, 44rem);
    }

    .home-blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem), (max-aspect-ratio: 4/5) {
    .home-hero__identity {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .home-hero__arms {
      width: min(52vw, 16rem);
    }

    .home-hero__identity p {
      text-align: center;
    }

    .home-project-grid,
    .home-blog-grid {
      grid-template-columns: 1fr;
    }

    .home-project-card,
    .home-blog-card a {
      aspect-ratio: 16 / 8;
    }
  }

  /* Keep the portrait laptop's arms in proportion to its wider cards. */
  @media (min-width: 40rem) and (max-aspect-ratio: 4/5) {
    .home-hero__arms {
      width: min(56vw, 28rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-project-card img,
    .home-blog-card img {
      transition-duration: .01ms;
    }
  }
</style>
