---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro'; import PostCard from '../components/PostCard.astro';
import { isPublished } from '../lib/site';
const posts=(await getCollection('blog')).filter(p=>isPublished(p.data)).sort((a,b)=>+b.data.date-+a.data.date).slice(0,3);
const worlds=[['Scholarship','/scholarship/','Research and writing across mathematics, operations research, technology, and public policy.'],['Teaching','/teaching/','Courses, instructional work, and a documentary syllabus archive.'],['Service','/service/','Public service, state emergency operations, nonprofit governance, and editorial work.'],['Software','/software/','Open-source packages and experiments that turn methods into working tools.'],['Ancestry','/ancestry/','Documented lineage research, certificates, societies, people, and places.'],['Books','/books/','Academic and policy books where technical problems get room to breathe.']];
---
<BaseLayout title="Home" profilePage>
  <section class="home-hero"><div class="container home-grid"><img src="/assets/img/identity/jameshoward-arms.svg" alt="James Howard coat of arms"><div><h1><span class="visually-hidden">James Howard</span><img src="/assets/img/identity/jameshoward-wordmark.svg" alt=""></h1><p>A Mathematician, a Different Kind of Mathematician, and a Statistician</p></div></div></section>
  <section class="section section--navy"><div class="reading-container text-center"><h2>What I Do</h2><p class="lead">I use mathematics, statistics, software, and artificial intelligence to understand complicated systems—and explain what they mean when people and institutions have to make decisions.</p></div></section>
  <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">The working archive</p><h2>Explore My World</h2></div><div class="record-grid">{worlds.map(([title,url,copy])=><article class="record-card"><h3><a href={url}>{title}</a></h3><p>{copy}</p><a href={url}>Explore →</a></article>)}</div></div></section>
  <section class="section section--soft"><div class="container"><div class="section-heading"><p class="eyebrow">Recently published</p><h2>From the Blog</h2></div><div class="card-grid">{posts.map(post=><PostCard post={post}/>)}</div><p class="text-center"><a class="button" href="/blog/">Browse the archive</a></p></div></section>
</BaseLayout>
<style>.home-hero{display:grid;min-height:calc(100vh - 4.6rem);align-items:center;padding:4rem 0;background:linear-gradient(105deg,rgb(10 27 47/.93),rgb(10 27 47/.6)),url('/assets/img/header-home.webp') center/cover}.home-grid{display:grid;grid-template-columns:minmax(15rem,30rem) minmax(18rem,38rem);align-items:center;justify-content:center;gap:clamp(3rem,8vw,8rem)}.home-grid>img{max-height:68vh;margin:auto}.home-grid h1{margin:0}.home-grid h1 img{width:100%;filter:brightness(0) invert(1)}.home-grid p{color:#fff;font-size:1.25rem;text-align:center}.lead{font-size:1.3rem}@media(max-width:48rem){.home-grid{grid-template-columns:1fr}.home-grid>img{width:45vw}.home-hero{min-height:auto}}</style>
