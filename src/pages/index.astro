---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationDirectory from '../components/DestinationDirectory.astro';
import HeadingDivider from '../components/HeadingDivider.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SubjectDirectory from '../components/SubjectDirectory.astro';
import { formatDate, isPublished, normalizeAssetPath, sitePath } from '../lib/site';
import siteData from '../../.generated/data/site.json';
import subjects from '../../.generated/data/subjects.json';

const posts = (await getCollection('blog'))
  .filter((post) => isPublished(post.data))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 4);

const featuredProjects = (siteData.settings.sites ?? [])
  .filter((site: any) => site.showcase)
  .sort((a: any, b: any) => (a.order ?? 999) - (b.order ?? 999));

const heroProjects = featuredProjects.slice(0, 4);

const workDestinations = [
  {
    title: 'Writing',
    href: '/writing/',
    description: 'Selected essays, subjects, and series drawn from the complete Blog archive.',
  },
  {
    title: 'Scholarship',
    href: '/scholarship/',
    description: 'Scholarly work and the complete research record.',
  },
  {
    title: 'Books',
    href: '/books/',
    description: 'Long-form work in mathematics, policy, operations research, and teaching.',
  },
  {
    title: 'Software',
    href: '/software/',
    description: 'Open-source projects and working tools built around difficult problems.',
  },
  {
    title: 'Teaching',
    href: '/teaching/',
    description: 'Courses, instructional work, and a documentary syllabus archive.',
  },
  {
    title: 'Service',
    href: '/service/',
    description: 'Public work, professional stewardship, and institutional responsibility.',
  },
];

const personalDestinations = [
  {
    title: 'Ancestry',
    href: '/ancestry/',
    description: 'Documented lineages, people, places, and the evidence connecting them.',
  },
  {
    title: 'Honors',
    href: '/honors/',
    description: 'Awards, appointments, decorations, and other recognition.',
  },
  {
    title: 'Coat of Arms',
    href: '/coat-of-arms/',
    description: 'The grant, insignia, emblazonments, tartan, and documentary record.',
  },
  {
    title: 'Media Archive',
    href: '/media/',
    description: 'Interviews, quotations, profiles, and appearances collected over the years.',
  },
];
---

<BaseLayout title="Home" profilePage>
  <section class="home-hero">
    <div class="container home-hero__top">
      <div class="home-hero__identity">
        <h1 class="visually-hidden">James Howard</h1>
        <img class="home-hero__arms" src="/assets/img/identity/jameshoward-arms.svg" alt="James Howard coat of arms">
        <p>A Mathematician, a Different Kind of Mathematician, and a Statistician</p>
      </div>

      <section class="home-hero__projects" aria-labelledby="home-projects">
        <div class="home-hero__label">
          <h2 id="home-projects">Selected Projects</h2>
        </div>
        <div class="home-project-grid">
          {heroProjects.map((project: any) => (
            <a
              class="home-project-card"
              href={project.url}
              target={project.target}
              rel={project.target ? 'noopener noreferrer' : undefined}
              aria-label={`Visit ${project.title}`}
            >
              <img
                src={project.image}
                alt=""
                loading="eager"
                decoding="async"
                style={`object-position: ${project.image_position ?? 'center'};`}
              />
              <span class="home-card-shade"></span>
              <span class="home-project-card__copy">
                {project.kind && <small>{project.kind}</small>}
                <strong>{project.title}</strong>
              </span>
            </a>
          ))}
        </div>
      </section>
    </div>

    <div class="home-hero__divider">
      <HeadingDivider variant="light"/>
    </div>

    <section class="container home-hero__blog" data-home-section="blog" aria-labelledby="home-latest-writing">
      <div class="home-hero__blog-heading">
        <div>
          <h2 id="home-latest-writing">From the Blog</h2>
        </div>
        <a href="/blog/">Complete archive →</a>
      </div>
      <div class="home-blog-grid">
        {posts.map((post) => (
          <article class="home-blog-card">
            <a data-home-post href={sitePath(post.data.route)} aria-label={`Read ${post.data.title}`}>
              <img src={normalizeAssetPath(post.data.featured_image)} alt="" loading="eager" decoding="async">
              <span class="home-card-shade"></span>
              <span class="home-blog-card__copy">
                <small>{formatDate(post.data.calendar_date, 'short')}</small>
                <strong>{post.data.title}</strong>
              </span>
            </a>
          </article>
        ))}
      </div>
    </section>
  </section>

  <section class="section section--cream" data-home-section="subjects">
    <div class="container">
      <SectionHeading title="Explore by Subject" description="Follow the ideas across writing, scholarship, books, software, teaching, and service."/>
      <SubjectDirectory subjects={subjects.subjects} heading="h3" variant="compact"/>
    </div>
  </section>

  <section class="section section--navy" data-home-section="work">
    <div class="container">
      <SectionHeading title="Browse the Work" description="Choose the kind of record you want to explore." variant="light"/>
      <DestinationDirectory entries={workDestinations} variant="dark"/>
      <p class="home-consulting">Have a complicated problem of your own? <a href="/consulting/">Consulting →</a></p>
    </div>
  </section>

  <section class="section" data-home-section="elsewhere">
    <div class="container">
      <SectionHeading title="Elsewhere on the Site" description="Personal archives, historical records, and a few less conventional corners."/>
      <DestinationDirectory entries={personalDestinations}/>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    align-content: center;
    gap: clamp(1.4rem, 2.4vh, 2.2rem);
    min-height: 100svh;
    padding: clamp(6.25rem, 9vh, 7.5rem) 0 clamp(1.5rem, 3vh, 2.5rem);
    overflow: hidden;
    background: #303030 url('/assets/img/header-home.webp') center/cover;
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);
    content: '';
  }

  .home-hero__top,
  .home-hero__blog,
  .home-hero__divider {
    position: relative;
    z-index: 1;
  }

  .home-hero__top,
  .home-hero__blog {
    width: min(94vw, 96rem);
  }

  .home-hero__divider {
    width: 100%;
  }

  .home-hero__top {
    display: grid;
    grid-template-columns: minmax(15rem, 28rem) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 5rem);
  }

  .home-hero__identity {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .home-hero__arms {
    width: min(100%, 28rem);
    max-height: 48vh;
    object-fit: contain;
    filter: drop-shadow(0 12px 25px rgb(0 0 0 / 20%));
  }

  .home-hero__identity p {
    max-width: 23rem;
    margin: 0;
    color: rgb(255 255 255 / 84%);
    font-size: clamp(.88rem, 1.15vw, 1.02rem);
    line-height: 1.45;
    text-align: center;
    text-wrap: balance;
  }

  .home-hero__projects {
    min-width: 0;
  }

  .home-hero__label,
  .home-hero__blog-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .7rem;
  }

  .home-hero__label h2,
  .home-hero__blog-heading h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.15rem, 1.7vw, 1.55rem);
    line-height: 1.12;
  }

  .home-project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(.65rem, 1vw, 1rem);
  }

  .home-project-card,
  .home-blog-card a {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: var(--radius-md);
    background: #111;
    box-shadow: 0 12px 28px rgb(0 0 0 / 18%);
    text-decoration: none;
    isolation: isolate;
  }

  .home-project-card {
    aspect-ratio: 16 / 7;
  }

  .home-project-card img,
  .home-blog-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.88) contrast(1.03);
    transition: transform .35s ease, filter .35s ease;
  }

  .home-card-shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(to top, rgb(7 17 31 / 88%) 0%, rgb(7 17 31 / 24%) 58%, rgb(7 17 31 / 4%) 100%);
  }

  .home-project-card__copy,
  .home-blog-card__copy {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: .22rem;
    padding: .82rem .95rem;
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 75%);
  }

  .home-project-card__copy small,
  .home-blog-card__copy small {
    color: var(--color-gold-300);
    font: 700 .62rem/1.2 var(--font-sans);
    letter-spacing: .065em;
    text-transform: uppercase;
  }

  .home-project-card__copy strong,
  .home-blog-card__copy strong {
    color: #fff;
    font: 600 clamp(.86rem, 1.05vw, 1.04rem)/1.2 var(--font-serif);
    text-wrap: balance;
  }

  .home-project-card:hover img,
  .home-project-card:focus-visible img,
  .home-blog-card a:hover img,
  .home-blog-card a:focus-visible img {
    filter: saturate(1) contrast(1.05);
    transform: scale(1.035);
  }

  .home-project-card:hover,
  .home-project-card:focus-visible,
  .home-blog-card a:hover,
  .home-blog-card a:focus-visible {
    border-color: var(--color-gold-300);
  }

  .home-hero__blog {
    padding-top: 0;
  }

  .home-hero__blog-heading a {
    color: rgb(255 255 255 / 82%);
    font: 700 .74rem var(--font-sans);
  }

  .home-hero__blog-heading a:hover,
  .home-hero__blog-heading a:focus-visible {
    color: var(--color-gold-300);
  }

  .home-blog-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(.65rem, 1vw, 1rem);
  }

  .home-blog-card {
    min-width: 0;
  }

  .home-blog-card a {
    aspect-ratio: 16 / 6.5;
  }

  .home-blog-card__copy {
    padding: .72rem .85rem;
  }


  .home-consulting {
    margin: var(--space-5) 0 0;
    color: rgb(255 255 255 / 82%);
    font: 700 1rem var(--font-sans);
    text-align: center;
  }

  .home-consulting a {
    color: var(--color-gold-300);
  }

  .home-consulting a:hover,
  .home-consulting a:focus-visible {
    color: #fff;
  }

  @media (max-width: 68rem) {
    .home-hero {
      align-content: start;
      min-height: 100svh;
    }

    .home-hero__top {
      grid-template-columns: minmax(12rem, 20rem) minmax(0, 1fr);
      gap: 2rem;
    }

    .home-hero__arms {
      max-height: 38vh;
    }

    .home-project-card {
      aspect-ratio: 16 / 8.5;
    }

    .home-blog-card a {
      aspect-ratio: 16 / 8;
    }
  }

  /* Tall viewports need the stacked composition even at laptop widths. */
  @media (max-width: 54rem), (max-aspect-ratio: 4/5) {
    .home-hero {
      align-content: start;
      min-height: auto;
      padding: 6.25rem 0 2.5rem;
      overflow: visible;
    }

    .home-hero__top {
      grid-template-columns: 1fr;
      width: min(92vw, 44rem);
    }

    .home-hero__identity {
      grid-template-columns: auto 1fr;
      align-items: center;
      justify-items: start;
      gap: 1.25rem;
    }

    .home-hero__arms {
      width: min(34vw, 12rem);
      max-height: none;
    }

    .home-hero__identity p {
      max-width: 23rem;
      text-align: left;
    }

    .home-hero__blog {
      width: min(92vw, 44rem);
    }

    .home-blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem), (max-aspect-ratio: 4/5) {
    .home-hero__identity {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .home-hero__arms {
      width: min(52vw, 16rem);
    }

    .home-hero__identity p {
      text-align: center;
    }

    .home-project-grid,
    .home-blog-grid {
      grid-template-columns: 1fr;
    }

    .home-project-card,
    .home-blog-card a {
      aspect-ratio: 16 / 8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-project-card img,
    .home-blog-card img {
      transition-duration: .01ms;
    }
  }
</style>
