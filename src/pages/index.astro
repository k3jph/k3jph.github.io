---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro'; import PostCard from '../components/PostCard.astro'; import SectionHeading from '../components/SectionHeading.astro'; import JHCard from '../components/JHCard.astro';
import { isPublished } from '../lib/site';
const posts=(await getCollection('blog')).filter(p=>isPublished(p.data)).sort((a,b)=>+b.data.date-+a.data.date).slice(0,3);
const worlds=[['Scholarship','/scholarship/','Research and writing across mathematics, operations research, technology, and public policy.'],['Teaching','/teaching/','Courses, instructional work, and a documentary syllabus archive.'],['Service','/service/','Public service, state emergency operations, nonprofit governance, and editorial work.'],['Software','/software/','Open-source packages and experiments that turn methods into working tools.'],['Ancestry','/ancestry/','Documented lineage research, certificates, societies, people, and places.'],['Books','/books/','Academic and policy books where technical problems get room to breathe.']];
---
<BaseLayout title="Home" profilePage>
  <section class="home-hero"><div class="container home-grid"><img src="/assets/img/identity/jameshoward-arms.svg" alt="James Howard coat of arms"><div><h1><span class="visually-hidden">James Howard</span><img src="/assets/img/identity/jameshoward-wordmark.svg" alt=""></h1><p>A Mathematician, a Different Kind of Mathematician, and a Statistician</p></div></div></section>
  <section class="section section--navy"><div class="reading-container text-center"><SectionHeading title="What I Do" variant="light"/><p class="lead">I use mathematics, statistics, software, and artificial intelligence to understand complicated systems—and explain what they mean when people and institutions have to make decisions.</p></div></section>
  <section class="section"><div class="container"><SectionHeading eyebrow="The working archive" title="Explore My World"/><div class="record-grid">{worlds.map(([title,url,copy])=><JHCard variant="featured"><h3><a href={url}>{title}</a></h3><p>{copy}</p><a href={url}>Explore →</a></JHCard>)}</div></div></section>
  <section class="section section--soft"><div class="container"><SectionHeading eyebrow="Recently published" title="From the Blog"/><div class="card-grid">{posts.map(post=><PostCard post={post}/>)}</div><p class="text-center"><a class="button" href="/blog/">Browse the archive</a></p></div></section>
</BaseLayout>
<style>.home-hero{display:grid;min-height:100vh;align-items:center;padding:7rem 0 4rem;background:linear-gradient(105deg,rgb(48 48 48/.92),rgb(48 48 48/.5)),url('/assets/img/header-home.webp') center/cover}.home-grid{display:grid;grid-template-columns:minmax(15rem,30rem) minmax(18rem,38rem);align-items:center;justify-content:center;gap:clamp(3rem,8vw,8rem)}.home-grid>img{max-height:68vh;margin:auto;filter:drop-shadow(0 12px 25px rgb(0 0 0/.2))}.home-grid h1{margin:0}.home-grid h1 img{width:100%;filter:brightness(0) invert(1)}.home-grid p{color:#fff;font-size:1.25rem;text-align:center}.lead{font-size:1.3rem}@media(max-width:48rem){.home-grid{grid-template-columns:1fr}.home-grid>img{width:45vw;max-height:40vh}.home-hero{min-height:100svh}}</style>
