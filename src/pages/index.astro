---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, isPublished, normalizeAssetPath, sitePath } from '../lib/site';
import siteData from '../../.generated/data/site.json';
import subjects from '../../.generated/data/subjects.json';
const books = siteData.books;

const posts = (await getCollection('blog')).filter((post) => isPublished(post.data))
  .sort((a, b) => +b.data.date - +a.data.date).slice(0, 4);
const [leadPost, ...recentPosts] = posts;
const projects = (siteData.settings.sites ?? []).filter((site: any) => site.showcase)
  .sort((a: any, b: any) => (a.order ?? 999) - (b.order ?? 999));
const historyProject = projects.find((project: any) => project.id === 'war1812');
const exhibitionProject = projects.find((project: any) => project.id === 'judith');
const bookProjects = projects.filter((project: any) => ['cmna', 'defenseor'].includes(project.id))
  .map((project: any) => ({ ...project,
    book: books.published.find((book: any) => book.short_route === (project.id === 'cmna' ? '/cmna/' : '/mdor/')),
  }));
const otherProjects = projects.filter((project: any) => !['war1812', 'judith', 'cmna', 'defenseor'].includes(project.id));
const additionalDestinations = [
  { title: 'Books', href: '/books/', description: 'Long-form work in mathematics, policy, operations research, and teaching.' },
  { title: 'Software', href: '/software/', description: 'Open-source projects and working tools built around difficult problems.' },
  { title: 'Consulting', href: '/consulting/', description: 'Have a complicated problem of your own?' },
];
const personalDestinations = [
  { id: 'ancestry', title: 'Ancestry', href: '/ancestry/', description: 'Documented lineages, people, places, and the evidence connecting them.', image: '/assets/img/ancestry/ofgd/granville-grant-teague-1756-11-05.webp', position: 'center 35%' },
  { id: 'arms', title: 'Coat of Arms', href: '/coat-of-arms/', description: 'The grant, insignia, emblazonments, tartan, and documentary record.', image: '/assets/img/armory/jhoward-coa-achernushkin-960px.webp', position: 'center' },
  { id: 'honors', title: 'Honors', href: '/honors/', description: 'Awards, appointments, decorations, and other recognition.', image: '/assets/img/kingdom-of-hawaii-medal-hero.webp', position: 'center 38%' },
  { id: 'media', title: 'Media Archive', href: '/media/', description: 'Interviews, quotations, profiles, and appearances collected over the years.', image: '/assets/img/news/radio-studio.webp', position: 'center' },
];
---

<BaseLayout title="Home" profilePage>
  <div class="home-editorial">
    <section class="home-hero" aria-labelledby="home-identity">
      <div class="home-hero__top home-wrap">
        <div class="home-hero__identity">
          <img class="home-hero__arms" src="/assets/img/identity/jameshoward-arms.svg" alt="James Howard coat of arms" width="432" height="489" fetchpriority="high"/>
        </div>
        <div class="home-hero__copy">
          <h1 id="home-identity">
            <span class="home-hero__prelude">A mathematician.</span>
            <span class="home-hero__statement">A different kind<br/> of mathematician.</span>
            <span class="home-hero__coda">And a statistician.</span>
          </h1>
          <p>Mathematics, software, public policy—and the occasional strange project.</p>
          <div class="home-hero__actions">
            <a class="home-action" href="#home-latest-writing">Read the latest <span aria-hidden="true">↓</span></a>
            <a class="home-text-link" href="#home-projects">Explore the projects <span aria-hidden="true">↘</span></a>
          </div>
        </div>
        <div class="home-hero__foot" aria-hidden="true"><span>Ideas. Methods. Evidence.</span><span>Scroll to explore ↓</span></div>
      </div>
    </section>

    <section class="home-writing home-section" data-home-section="blog" aria-labelledby="home-latest-writing">
      <div class="home-wrap">
        <div class="home-section-head">
          <div><p class="home-kicker">Notes from the working archive</p><h2 id="home-latest-writing">From the Blog</h2></div>
          <a class="home-text-link" href="/blog/">Complete archive <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-writing__layout">
          {leadPost && <article class="home-writing__lead">
            <a data-home-post href={sitePath(leadPost.data.route)} aria-labelledby="home-lead-title">
              <div class="home-writing__image"><img src={normalizeAssetPath(leadPost.data.featured_image)} alt="" loading="lazy" decoding="async"/></div>
              <div class="home-writing__lead-copy">
                <time class="home-date" datetime={leadPost.data.calendar_date.replace(/^D/, '')}>{formatDate(leadPost.data.calendar_date, 'short')}</time>
                <h3 id="home-lead-title">{leadPost.data.title}</h3>
                {leadPost.data.excerpt && <p>{leadPost.data.excerpt}</p>}
                <span class="home-read-link">Read the essay <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>}
          <div class="home-writing__recent">
            <p class="home-kicker">More recent writing</p>
            <ol>
              {recentPosts.map((post) => <li><article>
                <a data-home-post href={sitePath(post.data.route)}>
                  <time class="home-date" datetime={post.data.calendar_date.replace(/^D/, '')}>{formatDate(post.data.calendar_date, 'short')}</time>
                  <h3>{post.data.title}</h3>
                  {post.data.excerpt && <p>{post.data.excerpt}</p>}
                  <span class="home-read-link">Read <span aria-hidden="true">→</span></span>
                </a>
              </article></li>)}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="home-projects" data-home-section="projects" aria-labelledby="home-projects">
      <div class="home-wrap home-projects__heading"><p class="home-kicker">Independent sites & ongoing work</p><h2 id="home-projects">Selected Projects</h2></div>
      {historyProject && <article class="home-history">
        <img class="home-history__art" src={historyProject.image} alt="" loading="lazy" decoding="async" style={'object-position: ' + (historyProject.image_position ?? 'center') + ';'}/>
        <div class="home-wrap home-history__inner">
          <div class="home-history__copy">
            <p class="home-kicker">{historyProject.kind}</p>
            <h3><span class="home-history__year">1812</span> <span>The Whole Story</span></h3>
            <p>{historyProject.description}</p>
            <a class="home-action" data-home-project="war1812" href={historyProject.url} target={historyProject.target} rel="noopener noreferrer">Begin the story <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </article>}
      {exhibitionProject && <article class="home-exhibition">
        <div class="home-exhibition__image"><img src={exhibitionProject.image} alt="" loading="lazy" decoding="async" style={'object-position: ' + (exhibitionProject.image_position ?? 'center') + ';'}/></div>
        <div class="home-exhibition__copy">
          <p class="home-kicker">{exhibitionProject.kind}</p>
          <h3>Judith <span>&</span><br/> Holofernes</h3>
          <p class="home-exhibition__subtitle">The Fatal Image</p>
          <p>{exhibitionProject.description}</p>
          <a class="home-text-link" data-home-project="judith" href={exhibitionProject.url} target={exhibitionProject.target} rel="noopener noreferrer">Enter the exhibition <span aria-hidden="true">↗</span></a>
        </div>
      </article>}
      <div class="home-methods home-section">
        <div class="home-wrap">
          <div class="home-section-head"><div><p class="home-kicker">Books with a life beyond the page</p><h3>Methods you can put to work.</h3></div></div>
          <div class="home-methods__pair">
            {bookProjects.map((project: any) => <article class="home-book">
              {project.book && <img src={project.book.cover} alt={project.book.cover_alt} width={project.book.cover_width} height={project.book.cover_height} loading="lazy" decoding="async"/>}
              <div>
                <p class="home-kicker">{project.kind}</p>
                <h4>{project.title}</h4>
                {project.book && <p class="home-book__credit">{project.book.role} · {project.book.edition}</p>}
                <p>{project.description}</p>
                <a class="home-text-link" data-home-project={project.id} href={project.url} target={project.target} rel="noopener noreferrer">Explore the companion <span aria-hidden="true">↗</span></a>
              </div>
            </article>)}
          </div>
          {otherProjects.length > 0 && <div class="home-project-notes">
            {otherProjects.map((project: any) => <article>
              <p class="home-kicker">{project.kind}</p>
              <h4><a data-home-project={project.id} href={project.url} target={project.target} rel="noopener noreferrer">{project.title}<span aria-hidden="true"> ↗</span></a></h4>
              <p>{project.description}</p>
            </article>)}
          </div>}
        </div>
      </div>
    </section>

    <nav class="home-destinations home-wrap" aria-label="Books, software, and consulting">
      {additionalDestinations.map((destination) => <a href={destination.href}><span>{destination.title}<span aria-hidden="true"> ↗</span></span><p>{destination.description}</p></a>)}
    </nav>

    <section class="home-subjects home-section" data-home-section="subjects" aria-labelledby="home-subjects">
      <div class="home-wrap home-subjects__layout">
        <div class="home-subjects__intro">
          <img src="/assets/img/identity/kamon-info.svg" alt="" width="80" height="80" loading="lazy"/>
          <p class="home-kicker">Find your way in</p><h2 id="home-subjects">Explore<br/> by Subject</h2>
        </div>
        <ul class="home-subject-index">
          {subjects.subjects.map((subject: any) => <li><a data-home-subject href={subject.route}><span>{subject.title}</span><span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </div>
    </section>

    <section class="home-archives home-section" data-home-section="elsewhere" aria-labelledby="home-archives">
      <div class="home-wrap">
        <div class="home-section-head"><div><p class="home-kicker">People, symbols & the documentary record</p><h2 id="home-archives">The personal archive.</h2></div></div>
        <div class="home-archive-composition">
          {personalDestinations.map((destination) => <a data-home-archive={destination.id} class:list={['home-archive-entry', 'home-archive-entry--' + destination.id]} href={destination.href}>
            <div class="home-archive-entry__image"><img src={destination.image} alt="" loading="lazy" decoding="async" style={'object-position: ' + destination.position + ';'}/></div>
            <div class="home-archive-entry__copy"><h3>{destination.title}<span aria-hidden="true"> ↗</span></h3><p>{destination.description}</p></div>
          </a>)}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-editorial { --home-rule: rgb(11 28 51 / 20%); background: var(--color-cream); }
  .home-wrap { width: min(calc(100% - clamp(2.5rem, 8vw, 8rem)), 86rem); margin-inline: auto; }
  .home-section { padding-block: clamp(4rem, 7vw, 7rem); }
  .home-editorial :is(h1, h2, h3, h4, p) { margin: 0; }
  .home-editorial :is(h2, h3, h4) { font-family: var(--font-serif); font-weight: 400; }
  .home-editorial h2 { font-size: clamp(2.3rem, 4vw, 4rem); line-height: 1.1; }
  .home-editorial a { text-decoration: none; }
  .home-editorial :is(a, article, section, div) { min-width: 0; }
  .home-editorial [id^='home-'] { scroll-margin-top: 6rem; }
  .home-kicker { color: var(--color-gold-700); font: 700 .73rem/1.5 var(--font-sans); text-transform: uppercase; letter-spacing: .13em; }
  .home-section-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2.8rem; }
  .home-section-head .home-kicker { margin-bottom: .65rem; }
  .home-text-link, .home-read-link { display: inline-flex; align-items: center; gap: 1.5rem; color: var(--color-navy-900); font: 700 .9rem/1.4 var(--font-sans); }
  .home-text-link { padding-block: .65rem; border-bottom: 1px solid var(--color-gold-500); }
  .home-text-link > span, .home-read-link > span { color: var(--color-gold-700); transition: transform .2s ease; }
  a:hover .home-read-link > span, a.home-text-link:hover > span { transform: translateX(.25rem); }
  .home-date { display: block; color: var(--color-slate-700); font: 700 .73rem/1.5 var(--font-sans); letter-spacing: .04em; }
  .home-action { display: inline-flex; align-items: center; justify-content: space-between; gap: 2rem; min-height: 3.1rem; padding: .85rem 1.3rem; color: var(--color-navy-950); background: var(--color-gold-300); font: 700 .87rem/1.3 var(--font-sans); transition: background .2s ease; }
  .home-action:hover { color: var(--color-navy-950); background: #fff; }

  .home-hero { position: relative; isolation: isolate; overflow: hidden; color: var(--color-cream); background: var(--color-navy-950) url('/assets/img/header-home.webp') center / cover no-repeat; background-blend-mode: luminosity; }
  .home-hero::before { position: absolute; z-index: 0; inset: 0; background: radial-gradient(ellipse at 18% 48%, rgb(37 95 145 / 30%), transparent 58%), linear-gradient(115deg, rgb(7 17 31 / 88%), rgb(12 35 60 / 80%)); content: ''; pointer-events: none; }
  .home-hero__top { position: relative; z-index: 3; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); align-items: center; column-gap: clamp(3rem, 6vw, 7rem); row-gap: 3rem; min-height: min(58rem, 100svh); padding-block: clamp(8rem, 12vh, 11rem) 2rem; }
  .home-hero__identity { display: flex; align-items: center; justify-content: center; }
  .home-hero__arms { display: block; width: min(100%, 31rem); height: auto; filter: drop-shadow(0 18px 28px rgb(0 0 0 / 25%)); }
  .home-hero h1 { color: var(--color-cream); font-family: var(--font-serif); font-weight: 400; text-wrap: initial; }
  .home-hero h1 > span { display: block; }
  .home-hero__prelude, .home-hero__coda { font-size: clamp(1.25rem, 2.1vw, 2rem); line-height: 1.4; }
  .home-hero__prelude { margin-bottom: 1.2rem; }
  .home-hero__statement { font-size: clamp(2.5rem, 5.1vw, 5.6rem); line-height: 1.03; letter-spacing: -.035em; }
  .home-hero__coda { margin-top: 1.2rem; color: var(--color-gold-300); }
  .home-hero__copy > p { max-width: 32rem; margin-top: 2rem; color: rgb(248 244 233 / 80%); font-size: clamp(1rem, 1.35vw, 1.2rem); line-height: 1.6; }
  .home-hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem 1.8rem; margin-top: 2rem; }
  .home-hero__actions .home-text-link, .home-hero__actions .home-text-link > span { color: var(--color-cream); }
  .home-hero__foot { grid-column: 1 / -1; align-self: end; display: flex; justify-content: space-between; gap: 1rem; padding-top: 1.4rem; border-top: 1px solid rgb(230 199 125 / 25%); color: var(--color-gold-300); font: 400 .7rem/1.5 var(--font-display); letter-spacing: .08em; }

  .home-writing__layout { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); }
  .home-writing__lead > a { display: block; color: var(--color-navy-900); }
  .home-writing__image { overflow: hidden; aspect-ratio: 16 / 10; background: var(--color-navy-800); }
  .home-writing__image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .home-writing__lead a:hover img { transform: scale(1.025); }
  .home-writing__lead-copy { padding-top: 1.4rem; }
  .home-writing__lead h3 { margin-top: .5rem; font-size: clamp(2rem, 3.3vw, 3.4rem); line-height: 1.1; }
  .home-writing__lead-copy > p { max-width: 43rem; margin-top: 1rem; line-height: 1.65; }
  .home-writing__lead-copy .home-read-link { margin-top: 1.3rem; }
  .home-writing__recent > .home-kicker { margin-bottom: 1.4rem; }
  .home-writing__recent ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--home-rule); }
  .home-writing__recent li { border-bottom: 1px solid var(--home-rule); }
  .home-writing__recent a { display: block; padding-block: 1.6rem; color: var(--color-navy-900); }
  .home-writing__recent h3 { margin-top: .55rem; font-size: clamp(1.5rem, 2vw, 2rem); line-height: 1.18; }
  .home-writing__recent p { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 3; -webkit-box-orient: vertical; margin-top: .8rem; color: var(--color-slate-700); font-size: .96rem; line-height: 1.55; }
  .home-writing__recent .home-read-link { margin-top: 1rem; }
  .home-writing a:hover h3 { color: var(--color-gold-700); }

  .home-projects { background: #fff; }
  .home-projects__heading { padding-block: 3.5rem 2.5rem; }
  .home-projects__heading .home-kicker { margin-bottom: .7rem; }
  .home-history { position: relative; isolation: isolate; overflow: hidden; color: var(--color-cream); background: var(--color-navy-950); }
  .home-history__art { position: absolute; inset: 0; z-index: -2; display: block; width: 100%; height: 100%; object-fit: cover; }
  .home-history::before { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgb(7 17 31 / 96%), rgb(7 17 31 / 82%) 30%, rgb(7 17 31 / 15%) 78%); content: ''; }
  .home-history__inner { min-height: 42rem; display: flex; align-items: center; padding-block: 5rem; }
  .home-history__copy { max-width: 32rem; }
  .home-history .home-kicker { color: var(--color-gold-300); }
  .home-history h3 { margin-block: 1rem 1.6rem; color: var(--color-cream); line-height: 1; }
  .home-history h3 > span { display: block; font-size: clamp(2rem, 3.5vw, 3.4rem); }
  .home-history h3 .home-history__year { font-size: clamp(6rem, 12vw, 12rem); letter-spacing: -.055em; line-height: .85; margin-bottom: 1.1rem; }
  .home-history__copy > p:not(.home-kicker) { max-width: 29rem; font-size: 1.2rem; line-height: 1.65; }
  .home-history .home-action { margin-top: 2rem; }
  .home-exhibition { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); color: var(--color-cream); background: var(--color-navy-950); }
  .home-exhibition__image { position: relative; min-height: 39rem; overflow: hidden; }
  .home-exhibition__image img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
  .home-exhibition__copy { display: flex; flex-direction: column; align-items: start; justify-content: center; padding: clamp(2.5rem, 5vw, 6rem); }
  .home-exhibition .home-kicker { color: var(--color-gold-300); }
  .home-exhibition h3 { margin-top: 1.5rem; color: var(--color-cream); font-size: clamp(3rem, 5.6vw, 6rem); line-height: .97; letter-spacing: -.025em; }
  .home-exhibition h3 span { color: var(--color-gold-300); }
  .home-exhibition .home-exhibition__subtitle { margin-top: 1.4rem; color: var(--color-gold-300); font-size: 1.5rem; font-style: italic; }
  .home-exhibition__copy > p:not(.home-kicker):not(.home-exhibition__subtitle) { max-width: 30rem; margin-top: 1.4rem; color: rgb(248 244 233 / 82%); }
  .home-exhibition .home-text-link { margin-top: 2rem; color: var(--color-cream); }
  .home-exhibition .home-text-link > span { color: var(--color-gold-300); }
  .home-methods h3 { font-size: clamp(2.2rem, 3.8vw, 3.6rem); line-height: 1.12; }
  .home-methods__pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 5vw, 5rem); }
  .home-book { display: grid; grid-template-columns: minmax(0, .58fr) minmax(0, 1fr); align-items: start; gap: clamp(1.4rem, 2.5vw, 2.5rem); }
  .home-book > img { display: block; width: 100%; height: auto; box-shadow: 5px 9px 16px rgb(7 17 31 / 15%); }
  .home-book h4 { margin-top: .65rem; font-size: clamp(1.45rem, 2vw, 2rem); line-height: 1.2; }
  .home-book__credit { margin-top: .8rem !important; color: var(--color-slate-700); font: 400 .76rem/1.5 var(--font-sans); }
  .home-book p:not(.home-kicker):not(.home-book__credit) { margin-top: 1rem; font-size: 1rem; line-height: 1.6; }
  .home-book .home-text-link { margin-top: 1rem; }
  .home-project-notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 5vw, 5rem); margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--home-rule); }
  .home-project-notes h4 { margin-top: .6rem; font-size: 1.8rem; }
  .home-project-notes h4 a { color: var(--color-navy-900); }
  .home-project-notes h4 a:hover { color: var(--color-gold-700); }
  .home-project-notes h4 span { color: var(--color-gold-700); }
  .home-project-notes p:not(.home-kicker) { margin-top: .75rem; color: var(--color-slate-700); line-height: 1.6; }

  .home-destinations { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; padding-block: 3rem; border-bottom: 1px solid var(--home-rule); }
  .home-destinations > a { display: block; color: var(--color-navy-900); }
  .home-destinations > a > span { display: flex; justify-content: space-between; gap: 1rem; font: 400 clamp(1.3rem, 2.1vw, 2rem)/1.2 var(--font-display); }
  .home-destinations > a > span > span { color: var(--color-gold-700); }
  .home-destinations p { margin-top: .9rem; color: var(--color-slate-700); font-size: .96rem; line-height: 1.6; }
  .home-destinations > a:hover > span { color: var(--color-gold-700); }
  .home-subjects__layout { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.3fr); gap: clamp(2rem, 5vw, 5rem); }
  .home-subjects__intro img { display: block; width: 4rem; height: 4rem; margin-bottom: 1.6rem; }
  .home-subjects__intro .home-kicker { margin-bottom: .7rem; }
  .home-subject-index { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.2rem; margin: 0; padding: 0; list-style: none; }
  .home-subject-index li { border-top: 1px solid var(--home-rule); }
  .home-subject-index a { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.2rem; color: var(--color-navy-900); font-size: clamp(1.15rem, 1.6vw, 1.5rem); line-height: 1.3; }
  .home-subject-index a > span:last-child { color: var(--color-gold-700); font: 400 1.2rem var(--font-sans); }
  .home-subject-index a:hover { color: var(--color-gold-700); }

  .home-archives { color: var(--color-cream); background: var(--color-navy-900); }
  .home-archives h2 { color: var(--color-cream); }
  .home-archives .home-kicker { color: var(--color-gold-300); }
  .home-archive-composition { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .9fr) minmax(0, .85fr); gap: 1.6rem; }
  .home-archive-entry { display: flex; flex-direction: column; overflow: hidden; color: var(--color-cream); background: var(--color-navy-950); }
  .home-archive-entry--ancestry, .home-archive-entry--arms { grid-row: span 2; }
  .home-archive-entry__image { position: relative; flex: 1; min-height: 0; overflow: hidden; }
