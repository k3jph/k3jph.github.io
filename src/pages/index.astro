---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationDirectory from '../components/DestinationDirectory.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SubjectDirectory from '../components/SubjectDirectory.astro';
import { formatDate, isPublished, sitePath } from '../lib/site';
import siteData from '../../.generated/data/site.json';
import subjects from '../../.generated/data/subjects.json';

const posts = (await getCollection('blog'))
  .filter((post) => isPublished(post.data))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const selectedWork = [
  {
    kind: 'Scholarship · Artificial intelligence',
    title: 'Crystal Cube: Forecasting Disruptive Events',
    description: 'Forecasting disruption as a systems problem: combine signals, make the model useful, and confront the gap between prediction and decision.',
    href: 'https://doi.org/10.1080/08839514.2021.2001179',
    target: '_blank',
  },
  {
    kind: 'Book · Numerical analysis',
    title: 'Computational Methods for Numerical Analysis with R',
    description: 'Numerical analysis with the computation left visible, so approximation, error, and algorithmic choices can be inspected rather than merely asserted.',
    href: '/books/computational-methods-numerical-analysis-r/',
  },
  {
    kind: 'Digital humanities · Virtual exhibition',
    title: 'Judith & Holofernes: The Fatal Image',
    description: 'An explorable art-historical argument connecting works across eight centuries through research, images, and interface.',
    href: 'https://judith.jameshoward.us/',
    target: '_blank',
  },
];

const featuredProjects = (siteData.settings.sites ?? [])
  .filter((site: any) => site.showcase)
  .sort((a: any, b: any) => (a.order ?? 999) - (b.order ?? 999));

const workDestinations = [
  {
    title: 'Writing',
    href: '/writing/',
    description: 'Selected essays, subjects, and series drawn from the complete Blog archive.',
  },
  {
    title: 'Scholarship',
    href: '/scholarship/',
    description: 'Scholarly work and the complete research record.',
  },
  {
    title: 'Books',
    href: '/books/',
    description: 'Long-form work in mathematics, policy, operations research, and teaching.',
  },
  {
    title: 'Software',
    href: '/software/',
    description: 'Open-source projects and working tools built around difficult problems.',
  },
  {
    title: 'Teaching',
    href: '/teaching/',
    description: 'Courses, instructional work, and a documentary syllabus archive.',
  },
  {
    title: 'Service',
    href: '/service/',
    description: 'Public work, professional stewardship, and institutional responsibility.',
  },
];

const personalDestinations = [
  {
    title: 'Ancestry',
    href: '/ancestry/',
    description: 'Documented lineages, people, places, and the evidence connecting them.',
  },
  {
    title: 'Honors',
    href: '/honors/',
    description: 'Awards, appointments, decorations, and other recognition.',
  },
  {
    title: 'Coat of Arms',
    href: '/coat-of-arms/',
    description: 'The grant, insignia, emblazonments, tartan, and documentary record.',
  },
  {
    title: 'Media Archive',
    href: '/media/',
    description: 'Interviews, quotations, profiles, and appearances collected over the years.',
  },
];
---

<BaseLayout title="Home" profilePage>
  <section class="home-hero">
    <div class="container home-grid">
      <div class="home-hero__identity">
        <h1 class="visually-hidden">James Howard</h1>
        <img class="home-hero__arms" src="/assets/img/identity/jameshoward-arms.svg" alt="James Howard coat of arms">
        <p>A Mathematician, a Different Kind of Mathematician, and a Statistician</p>
      </div>

      <div class="home-hero__editorial">
        <section class="home-hero__work" aria-labelledby="home-selected-work">
          <div class="home-hero__section-heading">
            <p class="eyebrow">Selected Work</p>
            <h2 id="home-selected-work">A few ways into the work</h2>
          </div>
          <div class="home-work-list">
            {selectedWork.map((item) => (
              <a
                class="home-work-item"
                href={item.href}
                target={item.target}
                rel={item.target ? 'noopener noreferrer' : undefined}
              >
                <span class="home-work-item__kind">{item.kind}</span>
                <strong>{item.title}</strong>
                <span class="home-work-item__description">{item.description}</span>
                <span class="home-work-item__more">Read more →</span>
              </a>
            ))}
          </div>
          <a class="home-hero__all-link" href="/scholarship/">Explore scholarship →</a>
        </section>

        <section class="home-hero__blog" data-home-section="blog" aria-labelledby="home-latest-writing">
          <div class="home-hero__section-heading">
            <p class="eyebrow">Latest Writing</p>
            <h2 id="home-latest-writing">From the Blog</h2>
          </div>
          <div class="home-blog-list">
            {posts.map((post) => (
              <article class="home-blog-item">
                <p>{formatDate(post.data.calendar_date, 'short')}</p>
                <h3><a data-home-post href={sitePath(post.data.route)}>{post.data.title}</a></h3>
              </article>
            ))}
          </div>
          <nav class="home-blog-links" aria-label="Writing and Blog">
            <a href="/writing/">Selected writing →</a>
            <a href="/blog/">Complete archive →</a>
          </nav>
        </section>
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="reading-container text-center">
      <SectionHeading title="What I Do" variant="light"/>
      <p class="lead">I use mathematics, statistics, software, and artificial intelligence to understand complicated systems—and explain what they mean when people and institutions have to make decisions.</p>
    </div>
  </section>

  <section class="section section--cream" data-home-section="subjects">
    <div class="container">
      <SectionHeading title="Explore by Subject" description="Follow the ideas across writing, scholarship, books, software, teaching, and service."/>
      <SubjectDirectory subjects={subjects.subjects} heading="h3" variant="compact"/>
    </div>
  </section>

  <section class="section section--soft" data-home-section="projects">
    <div class="container">
      <SectionHeading title="Sites & Projects" description="Some projects need more room than a page. These are the sites that grew around them."/>
      <ProjectShowcase projects={featuredProjects}/>
    </div>
  </section>

  <section class="section section--navy" data-home-section="work">
    <div class="container">
      <SectionHeading title="Browse the Work" description="Choose the kind of record you want to explore." variant="light"/>
      <DestinationDirectory entries={workDestinations} variant="dark"/>
      <p class="home-consulting">Have a complicated problem of your own? <a href="/consulting/">Consulting →</a></p>
    </div>
  </section>

  <section class="section" data-home-section="elsewhere">
    <div class="container">
      <SectionHeading title="Elsewhere on the Site" description="Personal archives, historical records, and a few less conventional corners."/>
      <DestinationDirectory entries={personalDestinations}/>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    align-items: center;
    padding: clamp(6.5rem, 10vh, 8rem) 0 clamp(2.5rem, 5vh, 4rem);
    background: #303030 url('/assets/img/header-home.webp') center/cover;
  }

  .home-hero::before {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay);
    content: '';
  }

  .home-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(14rem, clamp(20rem, 25vw, 29rem)) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 6rem);
    width: min(94vw, 92rem);
  }

  .home-hero__identity {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2.2vh, 1.6rem);
    min-width: 0;
  }

  .home-hero__arms {
    width: 100%;
    max-height: 58vh;
    object-fit: contain;
    filter: drop-shadow(0 12px 25px rgb(0 0 0 / 20%));
  }

  .home-hero__identity p {
    max-width: 24rem;
    margin: 0;
    color: rgb(255 255 255 / 88%);
    font-size: clamp(.94rem, 1.35vw, 1.08rem);
    line-height: 1.5;
    text-align: center;
    text-wrap: balance;
  }

  .home-hero__editorial {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(17rem, .8fr);
    gap: clamp(2rem, 3.2vw, 4rem);
    min-width: 0;
  }

  .home-hero__work,
  .home-hero__blog {
    min-width: 0;
  }

  .home-hero__section-heading {
    padding-bottom: .9rem;
    border-bottom: 1px solid rgb(255 255 255 / 28%);
  }

  .home-hero__section-heading .eyebrow {
    margin: 0 0 .35rem;
    color: var(--color-gold-300);
  }

  .home-hero__section-heading h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.45rem, 2.1vw, 2rem);
    line-height: 1.12;
  }

  .home-work-list,
  .home-blog-list {
    display: grid;
  }

  .home-work-item {
    display: grid;
    gap: .34rem;
    padding: clamp(.8rem, 1.4vh, 1rem) 0;
    border-bottom: 1px solid rgb(255 255 255 / 16%);
    color: #fff;
    text-decoration: none;
  }

  .home-work-item:hover,
  .home-work-item:focus-visible {
    color: #fff;
  }

  .home-work-item__kind {
    color: var(--color-gold-300);
    font: 700 .69rem/1.3 var(--font-sans);
    letter-spacing: .075em;
    text-transform: uppercase;
  }

  .home-work-item strong {
    color: #fff;
    font: 600 clamp(1rem, 1.4vw, 1.16rem)/1.28 var(--font-serif);
  }

  .home-work-item__description {
    color: rgb(255 255 255 / 72%);
    font-size: clamp(.8rem, 1vw, .9rem);
    line-height: 1.42;
  }

  .home-work-item__more {
    color: rgb(255 255 255 / 88%);
    font: 700 .72rem var(--font-sans);
    opacity: 0;
    transform: translateX(-.25rem);
    transition: opacity .18s ease, transform .18s ease;
  }

  .home-work-item:hover .home-work-item__more,
  .home-work-item:focus-visible .home-work-item__more {
    opacity: 1;
    transform: translateX(0);
  }

  .home-blog-item {
    padding: clamp(.9rem, 1.6vh, 1.15rem) 0;
    border-bottom: 1px solid rgb(255 255 255 / 16%);
  }

  .home-blog-item > p {
    margin: 0 0 .38rem;
    color: var(--color-gold-300);
    font: 700 .69rem var(--font-sans);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .home-blog-item h3 {
    margin: 0;
    font-size: clamp(.98rem, 1.35vw, 1.14rem);
    line-height: 1.32;
  }

  .home-blog-item a {
    color: #fff;
    text-decoration: none;
  }

  .home-blog-item a:hover,
  .home-blog-item a:focus-visible,
  .home-hero__all-link:hover,
  .home-hero__all-link:focus-visible,
  .home-blog-links a:hover,
  .home-blog-links a:focus-visible {
    color: var(--color-gold-300);
  }

  .home-hero__all-link,
  .home-blog-links {
    margin-top: .85rem;
    font: 700 .78rem var(--font-sans);
  }

  .home-hero__all-link {
    display: inline-block;
    color: rgb(255 255 255 / 88%);
  }

  .home-blog-links {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem 1rem;
  }

  .home-blog-links a {
    color: rgb(255 255 255 / 88%);
  }

  .lead {
    font-size: 1.3rem;
  }

  .home-consulting {
    margin: var(--space-5) 0 0;
    color: rgb(255 255 255 / 82%);
    font: 700 1rem var(--font-sans);
    text-align: center;
  }

  .home-consulting a {
    color: var(--color-gold-300);
  }

  .home-consulting a:hover,
  .home-consulting a:focus-visible {
    color: #fff;
  }

  @media (max-width: 70rem) {
    .home-grid {
      grid-template-columns: minmax(12rem, 21rem) minmax(0, 1fr);
      gap: 2.5rem;
    }

    .home-hero__editorial {
      gap: 2rem;
    }

    .home-work-item__description {
      display: none;
    }
  }

  @media (max-width: 54rem) {
    .home-hero {
      min-height: 100svh;
      align-items: start;
      padding-top: 6.5rem;
    }

    .home-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      width: min(92vw, 44rem);
    }

    .home-hero__identity {
      grid-template-columns: auto 1fr;
      align-items: center;
      justify-items: start;
      gap: 1.25rem;
    }

    .home-hero__arms {
      width: min(30vw, 9rem);
      max-height: none;
    }

    .home-hero__identity p {
      max-width: 23rem;
      text-align: left;
    }

    .home-hero__editorial {
      grid-template-columns: 1fr 1fr;
    }

    .home-work-item__more {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .home-hero__identity {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .home-hero__arms {
      width: min(38vw, 10rem);
    }

    .home-hero__identity p {
      text-align: center;
    }

    .home-hero__editorial {
      grid-template-columns: 1fr;
    }

    .home-work-item__description {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-work-item__more {
      transition-duration: .01ms;
    }
  }
</style>
