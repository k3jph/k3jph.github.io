---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import JHCard from '../../components/JHCard.astro';
import SubjectLinks from '../../components/SubjectLinks.astro';
import siteData from '../../../.generated/data/site.json';
import subjectsData from '../../../.generated/data/subjects.json';
import { sitePath } from '../../lib/site';

const relatedSubjects = subjectsData.subjects.filter((subject) => ['mathematics-statistics', 'operations-research-decision-systems', 'risk-resilience', 'public-policy-institutions', 'software-open-systems', 'teaching-learning'].includes(subject.slug));
---
<BaseLayout title="Books">
  <PageIntro title="Books" subtitle="Long-form work in mathematics, operations research, education, and public policy." image="/assets/img/news/books.webp"/>
  <section class="section">
    <div class="container">
      <div class="book-grid books-shelf">{siteData.books.published.map((book:any)=><JHCard class="book-card" variant="featured"><a slot="media" href={sitePath(book.detail_url)}><img src={book.cover} alt={book.cover_alt} loading="lazy"></a><p class="eyebrow">{book.edition} · {book.year}</p><h2><a href={sitePath(book.detail_url)}>{book.title}</a></h2><p class="metadata">{book.role}</p><p set:html={book.summary}/></JHCard>)}</div>
      <SubjectLinks subjects={relatedSubjects} title="Explore the books by subject"/>
    </div>
  </section>
</BaseLayout>
<style>
  .books-shelf { max-width: 68rem; grid-template-columns: 1fr; gap: 3rem; }
  .books-shelf :global(.book-card) { grid-template-columns: minmax(8rem, 12rem) minmax(0, 1fr); gap: 3rem; padding-top: 2rem; border: 0; border-top: 1px solid var(--color-slate-300); }
  .books-shelf :global(.jh-card__body) { padding: 0; }
  .book-card h2 { margin: 0 0 var(--space-3); font-size: clamp(1.7rem, 3vw, 2.4rem); }
  .book-card h2 a { color: var(--color-navy-900); text-decoration-color: var(--color-gold-500); }
  @media (max-width: 40rem) { .books-shelf :global(.book-card) { grid-template-columns: minmax(5rem, 7rem) minmax(0, 1fr); gap: 1.25rem; } .book-card h2 { font-size: 1.5rem; } }
  @media (max-width: 30rem) { .books-shelf :global(.book-card) { grid-template-columns: 1fr; } .books-shelf :global(.jh-card__media) { width: 9rem; } }
</style>
