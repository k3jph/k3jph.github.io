---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageIntro from '../../components/PageIntro.astro';
---
<BaseLayout title="Search" description="Search jameshoward.us" image="/assets/img/researchlibrary.webp" noindex><PageIntro title="Search" subtitle="Find articles, site pages, and family-history research." image="/assets/img/researchlibrary.webp" compact/><section class="section section--soft"><div class="reading-container"><form id="search-form" class="search-form" role="search"><label for="search-input">Search JamesHoward.us</label><div class="search-control"><input type="search" id="search-input" name="q" placeholder="Try a name, topic, title, or phrase" autocomplete="off"><button class="button" type="reset">Clear</button></div></form><p id="search-status" class="metadata" role="status">Type to search the archive.</p><ol id="search-results" class="search-results"></ol><noscript><p>JavaScript is required for on-site search.</p></noscript></div></section><script>
import Fuse from 'fuse.js';
const input=document.querySelector<HTMLInputElement>('#search-input');const form=document.querySelector<HTMLFormElement>('#search-form');const status=document.querySelector('#search-status');const results=document.querySelector('#search-results');let fuse:Fuse<any>;
fetch('/data/search.json').then(r=>r.json()).then(items=>{fuse=new Fuse(items,{keys:['title','text','tags'],threshold:.34,ignoreLocation:true});const q=new URLSearchParams(location.search).get('q');if(q&&input){input.value=q;run();}}).catch(()=>{if(status)status.textContent='The search index could not be loaded.'});
function run(){if(!input||!results||!status||!fuse)return;const q=input.value.trim();results.replaceChildren();if(!q){status.textContent='Type to search the archive.';return;}const matches=fuse.search(q,{limit:50}).map(x=>x.item);status.textContent=`${matches.length} result${matches.length===1?'':'s'} for “${q}”.`;for(const item of matches){const li=document.createElement('li');const h=document.createElement('h2');const a=document.createElement('a');a.href=item.url;a.textContent=item.title;h.append(a);const p=document.createElement('p');p.textContent=item.excerpt;const meta=document.createElement('p');meta.textContent=item.type;li.append(h,meta,p);results.append(li);}}
input?.addEventListener('input',run);form?.addEventListener('reset',()=>setTimeout(run));
</script></BaseLayout>
<style>.search-form{padding:var(--space-5);border:1px solid var(--color-slate-150);border-top:3px solid var(--color-gold-500);background:#fff;box-shadow:var(--shadow-sm)}.search-form>label{display:block;margin-bottom:var(--space-3);font-family:var(--font-display);font-size:1.4rem}.search-control{display:grid;grid-template-columns:1fr auto;gap:var(--space-2)}.search-results{margin:var(--space-4) 0 0;padding:0;list-style:none}.search-results li{padding:var(--space-4) 0;border-top:1px solid var(--color-slate-300)}.search-results h2{margin:0;font-size:1.35rem}.search-results p{margin:.4rem 0}@media(max-width:36rem){.search-form{padding:var(--space-4)}.search-control{grid-template-columns:1fr}}</style>
